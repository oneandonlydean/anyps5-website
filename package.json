{
  "name": "anyps5-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:worker": "npm --prefix worker test",
    "sync:titles": "tsx scripts/sync-titles.ts",
    "sync:reports": "tsx scripts/ingest-discussions.ts",
    "sync:issues": "tsx scripts/sync-issues.ts",
    "sync:art": "tsx scripts/resolve-art.ts",
    "sync:screenshots": "tsx scripts/sync-screenshots.ts",
    "sync:merges": "tsx scripts/sync-merges.ts",
    "sync:uploads": "tsx scripts/sync-uploads.ts",
    "sync:builds": "tsx scripts/sync-builds.ts",
    "record:compat": "tsx scripts/record-compat.ts",
    "sync": "npm run sync:reports && npm run sync:uploads && npm run sync:builds && npm run sync:titles && npm run sync:issues && npm run sync:art && npm run sync:screenshots && npm run sync:merges && npm run record:compat",
    "fetch:upstream": "tsx scripts/fetch-upstream.ts",
    "fetch:coverage": "tsx scripts/fetch-coverage.ts",
    "fetch:commits": "tsx scripts/fetch-commits.ts",
    "validate": "tsx scripts/validate.ts",
    "icons": "tsx scripts/icons.ts",
    "deploy:demo": "sh scripts/deploy-demo.sh",
    "deploy:production": "sh scripts/deploy-production.sh",
    "refresh:demo": "sh scripts/refresh-demo.sh"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "@cfworker/json-schema": "^4.1.1",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.4.2",
    "marked": "^18.1.2",
    "marked-gfm-heading-id": "^4.1.4",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "pagefind": "^1.5.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.155.0"
  }
}
