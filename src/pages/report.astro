---
import Base from "../layouts/Base.astro";
import RunReportUpload from "../components/RunReportUpload.astro";
import { getGames } from "../lib/data";
import { DISCUSSIONS_URL, newReportUrl } from "../lib/site";

// Opened from a game page (?game=<slug>), the fallback links straight to that game's thread.
const games = await getGames();
const threads = Object.fromEntries(games.map((g) => [g.slug, { name: g.name, thread: g.threads[0]?.url ?? newReportUrl(`${g.name} (${g.titleIds[0]})`) }]));
---

<Base title="Upload a run report" description="Upload the run report AnyPS5 writes after each run, and your result goes on the AnyPS5 compatibility list.">
  <section class="container page-head">
    <span class="eyebrow">Upload a run report</span>
    <h1>Tell everyone how far it got</h1>
    <p class="lede">Every run helps, even the ones that crash. Upload the report AnyPS5 writes when a game stops, and your result goes straight onto the compatibility list.</p>
    <p class="new-game" id="new-game">
      <b>Game not on the list?</b> Upload its run report all the same: the game gets its own page at the next update. If the report doesn't say which game
      it was, you give the title ID and name, and a maintainer checks them first. No report file? <a href={newReportUrl()}>Post a bring-up report on GitHub</a>{" "}
      with the title ID, and the game is added from that.
    </p>
  </section>

  <div class="container">
    <div class="report">
      <RunReportUpload games={games.map((g) => ({ name: g.name, ids: g.titleIds }))} />

      <section class="card fallback" data-fallback data-threads={JSON.stringify(threads)}>
        <h2>No report file yet?</h2>
        <p class="muted">
          Released AnyPS5 builds don't write <code>anyps5-report.json</code> yet. Until they do, post your result in the Game bring-up discussions. The form asks for
          the title ID, your AnyPS5 build, your system and how far the game got.
        </p>
        <div class="actions">
          <a class="button primary" href={newReportUrl()} data-thread>Start a bring-up report</a>
          <a class="button" href={DISCUSSIONS_URL}>Browse the discussions</a>
        </div>
        <p class="muted small">
          Testing a game that's already listed? Its page on the <a href="/compatibility">compatibility list</a> links to its thread.
        </p>
      </section>
    </div>
  </div>
</Base>

<script>
  const fallback = document.querySelector<HTMLElement>("[data-fallback]")!;
  const slug = new URLSearchParams(location.search).get("game");
  const game = slug ? (JSON.parse(fallback.dataset.threads!) as Record<string, { name: string; thread: string }>)[slug] : undefined;
  if (game) {
    const link = fallback.querySelector<HTMLAnchorElement>("[data-thread]")!;
    link.href = game.thread;
    link.textContent = `Report on ${game.name}`;
  }
</script>

<style>
  .new-game {
    max-width: 640px;
    margin: 20px 0 0;
    padding: 12px 16px;
    border-left: 3px solid var(--accent);
    border-radius: 0 10px 10px 0;
    background: color-mix(in srgb, var(--accent) 7%, transparent);
    color: var(--muted);
    font-size: 0.92rem;
    /* Clear of the sticky header when the list's "Add a missing game" lands here. */
    scroll-margin-top: 96px;
  }
  .new-game b {
    color: var(--text);
  }
  .report {
    max-width: 860px;
    padding-bottom: 96px;
  }
  .fallback {
    display: grid;
    gap: 12px;
    padding: clamp(20px, 3vw, 28px);
  }
  .fallback h2 {
    margin: 0;
    font-size: 1.05rem;
  }
  .fallback p {
    margin: 0;
    font-size: 0.92rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .small {
    font-size: 0.84rem !important;
  }
</style>
