---
import Base from "../layouts/Base.astro";
import LibraryMap from "../components/progress/LibraryMap.astro";
import BarChart from "../components/progress/BarChart.astro";
import Timeline from "../components/progress/Timeline.astro";
import LineChart from "../components/progress/LineChart.astro";
import Sparkline from "../components/Sparkline.astro";
import { getGames, getNeeds } from "../lib/data";
import { openFunctions, tallyWanted, type Needs } from "../lib/needs";
import { formatDate, REPO_URL } from "../lib/site";
import { getCommits, getCompatHistory, getCoverage, getProgress, getProgressHistory, type Coverage } from "../lib/upstream";
import { atLeast, gameSeries } from "../lib/compat-history";
import { stageRank } from "../lib/stages";

const [progress, libraryHistory, coverage, needs, games, compatHistory, commits] = await Promise.all([getProgress(), getProgressHistory(), getCoverage(), getNeeds(), getGames(), getCompatHistory(), getCommits()]);
const number = new Intl.NumberFormat("en-GB");
const percent = (done: number, total: number, digits = 2) => `${total ? ((done / total) * 100).toFixed(digits) : "0"}%`;

const libraries = progress?.libraries;
const inert = libraries?.groups.reduce((n, g) => n + g.inert, 0) ?? 0;
const complete = libraries?.groups.filter((g) => g.done === g.total).length ?? 0;

// Encodings in reading order, with what each one is for.
const ENCODINGS: Record<string, string> = {
  SOP1: "Scalar ALU, one operand",
  SOP2: "Scalar ALU, two operands",
  SOPK: "Scalar ALU with an inline constant",
  SOPC: "Scalar compare",
  SOPP: "Program control and branches",
  SMEM: "Scalar memory",
  VOP1: "Vector ALU, one operand",
  VOP2: "Vector ALU, two operands",
  VOP3: "Vector ALU, three operands",
  VOP3P: "Packed vector math",
  VOPC: "Vector compare",
  VINTRP: "Attribute interpolation",
  DS: "Local and global data share",
  MUBUF: "Untyped buffer memory",
  MTBUF: "Typed buffer memory",
  MIMG: "Image sample, load and store",
  FLAT: "Flat memory",
  GLOBAL: "Global memory",
  SCRATCH: "Scratch memory",
  EXP: "Export to render targets",
};
const FORMS = [
  { key: "base", label: "Own encoding" },
  { key: "vop3", label: "As VOP3" },
  { key: "dpp16", label: "DPP16" },
  { key: "dpp8", label: "DPP8" },
] as const;

// Encodings grouped the way the ISA is: scalar ALU, vector ALU, memory.
const GROUPS = [
  { title: "Scalar", encodings: ["SOP1", "SOP2", "SOPK", "SOPC", "SOPP", "SMEM"] },
  { title: "Vector", encodings: ["VOP1", "VOP2", "VOP3", "VOP3P", "VOPC", "VINTRP"] },
  { title: "Memory and export", encodings: ["DS", "MUBUF", "MTBUF", "MIMG", "FLAT", "GLOBAL", "SCRATCH", "EXP"] },
];
const matrix = coverage
  ? Object.keys(ENCODINGS)
      .map((encoding) => ({ encoding, cells: FORMS.map((f) => coverage.forms.find((c) => c.encoding === encoding && c.form === f.key) ?? null) }))
      .filter((row) => row.cells.some(Boolean))
  : [];

/** The day closest to `days` before the last one, for "change since" figures. */
function before(history: Coverage["history"], days: number) {
  const last = new Date(history.at(-1)!.date).getTime();
  return history.find((h) => last - new Date(h.date).getTime() <= days * 864e5) ?? history[0];
}
const tiles = GROUPS.map((g) => ({
  title: g.title,
  rows: matrix
    .filter((row) => g.encodings.includes(row.encoding))
    .map((row) => {
      const forms = row.cells.flatMap((c, i) => (c ? [{ ...c, label: FORMS[i].label }] : []));
      const decoded = forms.reduce((n, f) => n + f.decoded, 0);
      const total = forms.reduce((n, f) => n + f.total, 0);
      return { encoding: row.encoding, forms, decoded, total, missing: forms.flatMap((f) => f.missing.map((name) => ({ form: f.label, name }))) };
    }),
}));
const throwsSince = coverage && {
  first: coverage.history[0],
  month: before(coverage.history, 30),
};

/** "Format8_8_8_8UNorm" → "8_8_8_8 UNorm"; FMASK and block-compressed names keep their own shape. */
function formatLabel(name: string | null, value: number) {
  if (!name) return `#${value}`;
  return name
    .replace(/^Format/, "")
    .replace(/(UNorm|SNorm|UScaled|SScaled|UInt|SInt|Float|Srgb|UBNorm|UBScaled)/, " $1")
    .replace(/_/g, "·")
    .trim();
}

const site = (file: string, line: number) => `${REPO_URL}/blob/${coverage!.commit}/core/shader/recompiler/${file}#L${line}`;
const throwsByFile = coverage
  ? Object.entries(Object.groupBy(coverage.throws.sites, (s) => s.file)).sort((a, b) => b[1]!.length - a[1]!.length || a[0].localeCompare(b[0]))
  : [];
const shaderDates = coverage?.history.map((h) => h.date) ?? [];

// What games are waiting on: open functions and errors named in each game's newest blocker, by how many games name them.
const gameName = new Map(games.map((g) => [g.slug, g.name]));
const wanted = <T,>(pick: (n: Needs) => T[], key: (item: T) => string) => tallyWanted(needs, pick, key);
const wantedFunctions = wanted(openFunctions, (f) => f.name).slice(0, 12);
const wantedErrors = wanted((n) => n.errors, (e) => e.message).slice(0, 10);
// The same, by library, for the library map's flags and panel.
const missingNeeds = wanted(openFunctions, (f) => f.name);
const waitingByLibrary: Record<string, { slug: string; name: string }[]> = {};
for (const { item, games: slugs } of missingNeeds) {
  const list = (waitingByLibrary[item.library] ??= []);
  for (const slug of slugs) if (!list.some((g) => g.slug === slug)) list.push({ slug, name: gameName.get(slug) ?? slug });
}
const wantedByFunction = Object.fromEntries(missingNeeds.map(({ item, games: slugs }) => [item.name, slugs.length]));

// Games over time: recorded daily since the record started, rebuilt from each game's rises before that.
const today = new Date().toISOString().slice(0, 10);
const compat = gameSeries(games, compatHistory, today);
const compatNow = compat.days.at(-1)?.counts ?? {};
// The change over the last 30 days, or since the first report while there are fewer.
const compatFrom = compat.days.at(-31) ?? compat.days[0];
const compatMonthAgo = compatFrom?.counts ?? {};
const gameFacts = [
  { label: "Tested", stage: null },
  { label: "Presents or better", stage: "Presents" },
  { label: "Ingame or better", stage: "Ingame" },
] as const;
// This week against the week before: what is being done, not only where things stand.
const DAY = 864e5;
const end = Date.parse(`${today}T23:59:59Z`);
const week = (iso: string) => Math.floor((end - Date.parse(iso)) / (7 * DAY));
const results = games.flatMap((g) => [...g.reports.map((r) => ({ date: r.date, by: r.author })), ...g.uploads.map((u) => ({ date: u.at, by: u.login }))]);
const firstIngame = games.flatMap((g) => g.timeline.find((e) => stageRank(e.stage) >= stageRank("Ingame"))?.date ?? []);
const functionsAt = (days: number) => libraryHistory.filter((d) => Date.parse(d.date) <= end - days * DAY).at(-1)?.libraries.done;
const functionsGained = (from: number, to: number) => {
  const [a, b] = [functionsAt(to), functionsAt(from)];
  return a === undefined || b === undefined ? null : b - a;
};
const pace = [
  { label: "Test results", now: results.filter((r) => week(r.date) === 0).length, before: results.filter((r) => week(r.date) === 1).length },
  {
    label: "Testers",
    now: new Set(results.filter((r) => week(r.date) === 0).map((r) => r.by)).size,
    before: new Set(results.filter((r) => week(r.date) === 1).map((r) => r.by)).size,
  },
  { label: "Games newly in game", now: firstIngame.filter((d) => week(d) === 0).length, before: firstIngame.filter((d) => week(d) === 1).length },
  { label: "Functions implemented", now: functionsGained(0, 7), before: functionsGained(7, 14) },
];

// Commits per day on upstream main. The day the counts were taken is still in progress, so it is drawn as partial
// and left out of the weekly figures.
const commitDays = commits?.days ?? [];
const commitsPartial = commitDays.at(-1)?.date === commits?.synced.slice(0, 10);
const fullDays = commitsPartial ? commitDays.slice(0, -1) : commitDays;
const commitTotal = commitDays.reduce((n, d) => n + d.commits, 0);
const commitWeek = (from: number) => fullDays.slice(Math.max(0, fullDays.length - from - 7), fullDays.length - from).reduce((n, d) => n + d.commits, 0);
const busiest = fullDays.reduce<(typeof fullDays)[number] | undefined>((best, d) => (!best || d.commits > best.commits ? d : best), undefined);
---

<Base title="Progress" description="How much of the PS5 system libraries and the RDNA 2 shader instruction set AnyPS5 implements, measured from its source.">
  <section class="container page-head">
    <span class="eyebrow">Implementation progress</span>
    <h1>How much is done</h1>
    <p class="lede">
      AnyPS5 reimplements the PS5's system libraries and recompiles its GPU shaders. Every number here is measured from the project's source on each build, so nobody keeps these figures by hand.
    </p>
    <nav class="jump" aria-label="On this page">
      <a href="#games">Games</a>
      <a href="#commits">Commits</a>
      <a href="#libraries">System libraries</a>
      <a href="#shaders">Shader recompiler</a>
      <a href="#wanted">Most wanted</a>
      <a href="#method">How it's measured</a>
    </nav>
  </section>

  {
    compat.days.length > 1 && (
      <section class="container block" id="games">
        <div class="card part">
          <header class="part-head">
            <div>
              <span class="eyebrow">Games</span>
              <h2>
                <span class="big">{number.format(atLeast(compatNow, "Ingame"))}</span> games reach gameplay
              </h2>
              <p class="muted">
                How many tested games reach each point, day by day: the furthest stage on a main build, as the <a href="/compatibility">compatibility list</a> shows it. The <a href="/compatibility/tracked">tracked games</a> show the same release by release.
              </p>
            </div>
            <div>
              <dl class="facts">
                {gameFacts.map((f) => {
                  const change = atLeast(compatNow, f.stage) - atLeast(compatMonthAgo, f.stage);
                  return (
                    <div>
                      <dt>{f.label}</dt>
                      <dd>
                        {number.format(atLeast(compatNow, f.stage))} {change !== 0 && <small>{change > 0 ? "+" : "−"}{number.format(Math.abs(change))}</small>}
                      </dd>
                    </div>
                  );
                })}
              </dl>
              {compatFrom && <p class="facts-since">Change since {formatDate(compatFrom.date)}</p>}
            </div>
          </header>
          <div class="chart-wrap">
            <LineChart
              title="Games by furthest stage"
              unit="games"
              dates={compat.days.map((d) => d.date)}
              series={[
                { label: "Tested", values: compat.days.map((d) => atLeast(d.counts, null)), color: "var(--faint)", dashed: true },
                { label: "Presents or better", values: compat.days.map((d) => atLeast(d.counts, "Presents")), color: "var(--stage-presents)" },
                { label: "Ingame or better", values: compat.days.map((d) => atLeast(d.counts, "Ingame")), color: "var(--stage-ingame)" },
              ]}
            />
            <p class="hint">
              {compat.rebuiltUntil ? <>Before {formatDate(compat.rebuiltUntil)} the counts are rebuilt from the dates of each game's reports; from then on they are recorded each day.</> : <>Counts are rebuilt from the dates of each game's reports until the site's daily record starts.</>}
            </p>
          </div>
          <div class="pace">
            <h3>The last 7 days</h3>
            <dl class="facts">
              {pace.map((p) => (
                <div>
                  <dt>{p.label}</dt>
                  <dd>
                    {p.now === null ? "—" : number.format(p.now)} {p.before !== null && <small>{number.format(p.before)} the week before</small>}
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        </div>
      </section>
    )
  }


  {
    commitDays.length > 1 && (
      <section class="container block" id="commits">
        <div class="card part">
          <header class="part-head">
            <div>
              <span class="eyebrow">Development</span>
              <h2>
                <span class="big">{number.format(commitTotal)}</span> commits on main
              </h2>
              <p class="muted">
                Every commit on upstream <a href={REPO_URL}>main</a>, counted by the UTC day it was written. Merge commits are included, so the total matches what GitHub shows.
              </p>
            </div>
            <dl class="facts">
              <div><dt>Last 7 days</dt><dd>{number.format(commitWeek(0))} <small>{number.format(commitWeek(7))} the week before</small></dd></div>
              {busiest && <div><dt>Busiest day</dt><dd>{number.format(busiest.commits)} <small>{formatDate(busiest.date)}</small></dd></div>}
            </dl>
          </header>
          <div class="chart-wrap">
            <BarChart title="Commits per day" unit="commits" dates={commitDays.map((d) => d.date)} values={commitDays.map((d) => d.commits)} partial={commitsPartial} />
          </div>
          {/* What those days' merges built, day by day. */}
          <div class="timeline-wrap">
            <Timeline />
          </div>
        </div>
      </section>
    )
  }

  {
    libraries && (
      <section class="container block" id="libraries">
        <div class="card part">
          <header class="part-head">
            <div>
              <span class="eyebrow">System libraries</span>
              <h2>
                <span class="big">{percent(libraries.done, libraries.total)}</span> of declared functions implemented
              </h2>
              <p class="muted">
                Each tile is one PS5 system library, grouped by what it does, sized by how many functions it has, and greener the more of them work. A ⚑ marks libraries that games are stuck on right now. The total grows as more functions are found.
              </p>
            </div>
            <dl class="facts">
              <div><dt>Implemented</dt><dd>{number.format(libraries.done)}</dd></div>
              <div><dt>Missing</dt><dd>{number.format(libraries.total - libraries.done)}</dd></div>
              <div><dt>No-op bodies</dt><dd title="Implemented functions that only discard their arguments and return a constant">{number.format(inert)}</dd></div>
              <div><dt>Complete libraries</dt><dd>{complete} <small>of {libraries.groups.length}</small></dd></div>
            </dl>
          </header>
          <div class="meter" role="img" aria-label={`${percent(libraries.done, libraries.total)} implemented`}>
            <span style={`width:${(libraries.done / libraries.total) * 100}%`} />
          </div>
          <LibraryMap groups={libraries.groups} waiting={waitingByLibrary} wanted={wantedByFunction} />
          {libraryHistory.length > 1 && (
            <div class="chart-wrap">
              <LineChart
                title="Library functions over time"
                unit="functions"
                dates={libraryHistory.map((d) => d.date)}
                series={[
                  { label: "Implemented", values: libraryHistory.map((d) => d.libraries.done), color: "var(--good)" },
                  { label: "Declared", values: libraryHistory.map((d) => d.libraries.total), color: "var(--faint)", dashed: true },
                ]}
              />
            </div>
          )}
        </div>
      </section>
    )
  }

  {
    coverage && throwsSince && (
      <section class="container block" id="shaders">
        <div class="section-intro">
          <span class="eyebrow">Shader recompiler</span>
          <h2>Translating {coverage.isa} shaders to Vulkan</h2>
          <p class="muted">
            Measured against AMD's machine-readable {coverage.isa} instruction set, on upstream <code>main</code> at{" "}
            <a href={`${REPO_URL}/commit/${coverage.commit}`}>
              <code>{coverage.commit.slice(0, 9)}</code>
            </a>{" "}
            ({formatDate(coverage.date)}).
          </p>
        </div>

        <div class="tiles">
          <div class="card tile">
            <span class="label">Instruction forms</span>
            <b>
              <span data-count={((coverage.instructions.decoded / coverage.instructions.total) * 100).toFixed(2)} data-digits="2">
                {((coverage.instructions.decoded / coverage.instructions.total) * 100).toFixed(2)}
              </span>
              %
            </b>
            <span class="muted">
              {number.format(coverage.instructions.decoded)} of {number.format(coverage.instructions.total)} decode; {number.format(coverage.instructions.translated)} also translate
            </span>
            <Sparkline values={coverage.history.map((h) => h.instructions?.decoded ?? null)} color="var(--accent-2)" label="Decoded instruction forms over time" />
          </div>
          <div class="card tile">
            <span class="label">DPP lane swizzles</span>
            <b>{percent(coverage.dpp.decoded, coverage.dpp.total)}</b>
            <span class="muted">
              {coverage.dpp.decoded} of {coverage.dpp.total} DPP16 and DPP8 forms
            </span>
            <Sparkline values={coverage.history.map((h) => h.dpp?.decoded ?? null)} color="var(--accent-2)" label="Accepted DPP forms over time" />
          </div>
          <div class="card tile">
            <span class="label">Image formats</span>
            <b>{percent(coverage.formats.sampled, coverage.formats.total)}</b>
            <span class="muted">
              {coverage.formats.sampled} of {coverage.formats.total} can be sampled; {coverage.formats.buffer} as buffers
            </span>
          </div>
          <div class="card tile">
            <span class="label">Descriptor types</span>
            <b>
              {coverage.descriptors.filter((d) => d.handled).length}
              <small>/{coverage.descriptors.length}</small>
            </b>
            <span class="muted">image dimensions mapped</span>
          </div>
          <div class="card tile throws">
            <span class="label">Unsupported cases</span>
            <b data-count={coverage.throws.total}>{coverage.throws.total}</b>
            <span class="muted">
              {throwsSince.first.throws > coverage.throws.total ? (
                <>
                  <span class="down">↓ {throwsSince.first.throws - coverage.throws.total}</span> since {formatDate(throwsSince.first.date)}
                </>
              ) : (
                <>since {formatDate(throwsSince.first.date)}</>
              )}
              {throwsSince.month !== throwsSince.first && (
                <>
                  ; {coverage.throws.total - throwsSince.month.throws >= 0 ? "+" : "−"}
                  {Math.abs(coverage.throws.total - throwsSince.month.throws)} in 30 days
                </>
              )}
            </span>
            <Sparkline values={coverage.history.map((h) => h.throws)} color="var(--accent)" label="Unsupported cases over time" />
          </div>
        </div>

        <div class="card part">
          <header class="part-head">
            <div>
              <h3>Instructions by encoding</h3>
              <p class="muted">
                Every {coverage.isa} instruction in every encoding it can take, and how many the decoder accepts. Vector instructions also come in the 64-bit VOP3 encoding and with DPP lane-swizzle words. Tiles with gaps list what is missing.
              </p>
            </div>
          </header>
          {tiles.map((group) => (
            <section class="enc-group">
              <h4>{group.title}</h4>
              <ul class="enc-tiles">
                {group.rows.map((t) => (
                  <li class:list={["enc-tile", { full: t.decoded === t.total }]} style={`--pct:${(t.decoded / t.total) * 100}`}>
                    <div class="enc-top">
                      <span class="ring" role="img" aria-label={`${t.decoded} of ${t.total} forms decoded`}>
                        <span>{Math.floor((t.decoded / t.total) * 100)}%</span>
                      </span>
                      <span class="enc-name">
                        <b class="mono">{t.encoding}</b>
                        <span class="muted">{ENCODINGS[t.encoding]}</span>
                      </span>
                    </div>
                    <ul class="enc-forms">
                      {t.forms.map((f) => (
                        <li style={`--fill:${(f.decoded / f.total) * 100}%`}>
                          <span>{f.label}</span>
                          <span class="mini" aria-hidden="true" />
                          <span class="mono">
                            {f.decoded}/{f.total}
                          </span>
                        </li>
                      ))}
                    </ul>
                    {t.missing.length > 0 && (
                      <details class="enc-missing">
                        <summary>{t.missing.length} not decoded</summary>
                        <p class="mono">{t.missing.map((m) => (t.forms.length > 1 ? `${m.name} (${m.form})` : m.name)).join(", ")}</p>
                      </details>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          ))}
          {coverage.untranslated.length > 0 && (
            <p class="note">
              Decoded but not yet translated: <span class="mono">{coverage.untranslated.join(", ")}</span>
            </p>
          )}
          <div class="chart-wrap">
            <LineChart
              title="Instruction forms decoded over time"
              unit="forms"
              dates={shaderDates}
              series={[
                { label: "Decoded", values: coverage.history.map((h) => h.instructions?.decoded ?? null), color: "var(--accent-2)" },
                { label: "In the instruction set", values: coverage.history.map((h) => h.instructions?.total ?? null), color: "var(--faint)", dashed: true },
              ]}
            />
          </div>
        </div>

        <div class="card part">
          <header class="part-head">
            <div>
              <h3>Unsupported cases left</h3>
              <p class="muted">
                Places where the recompiler stops with an error saying something is unsupported or not implemented: an operand combination, a format or a shader feature it does not handle yet. As support grows, rejections are first written down and then removed, so this can rise before it falls.
              </p>
            </div>
          </header>
          <div class="throws-grid">
            <LineChart title="Unsupported cases over time" unit="cases" dates={shaderDates} series={[{ label: "Unsupported cases", values: coverage.history.map((h) => h.throws), color: "var(--accent)" }]} />
            <div>
              <p class="label">By component</p>
              <ul class="areas">
                {coverage.throws.areas.map((a) => (
                  <li>
                    <span>{a.name}</span>
                    <span class="area-bar" style={`--w:${(a.count / coverage.throws.areas[0].count) * 100}%`} />
                    <span class="mono">{a.count}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
          <details class="sites" data-pagefind-ignore>
            <summary>All {coverage.throws.total} cases, by file</summary>
            <div class="sites-list">
              {throwsByFile.map(([file, sites]) => (
                <section>
                  <h4 class="mono">
                    {file} <span class="muted">{sites!.length}</span>
                  </h4>
                  <ul>
                    {sites!.map((s) => (
                      <li>
                        <a class="mono" href={site(s.file, s.line)}>
                          L{s.line}
                        </a>{" "}
                        {s.message}
                      </li>
                    ))}
                  </ul>
                </section>
              ))}
            </div>
          </details>
        </div>

        <div class="card part">
          <header class="part-head">
            <div>
              <h3>Image formats</h3>
              <p class="muted">
                Every format value a texture or buffer descriptor can name, and which layers handle it: the recompiler can <b>sample</b> it, read or write it as a typed <b>buffer</b>, and the graphics driver maps it to a <b>Vulkan</b> texture format.
              </p>
            </div>
            <div class="chips" role="group" aria-label="Show formats" data-format-filter>
              <button type="button" aria-pressed="true" data-show="all">All {coverage.formatRows.length}</button>
              <button type="button" aria-pressed="false" data-show="sampled">Sampled {coverage.formats.sampled}</button>
              <button type="button" aria-pressed="false" data-show="buffer">Buffer {coverage.formats.buffer}</button>
              <button type="button" aria-pressed="false" data-show="host">Vulkan {coverage.formats.host}</button>
              <button type="button" aria-pressed="false" data-show="none">Unhandled {coverage.formatRows.filter((f) => !f.sampled && !f.buffer && !f.host).length}</button>
            </div>
          </header>
          <ul class="formats" data-formats data-pagefind-ignore>
            {coverage.formatRows.map((f) => (
              <li
                class:list={{ unnamed: !f.name }}
                data-sampled={f.sampled ? "" : undefined}
                data-buffer={f.buffer ? "" : undefined}
                data-host={f.host ? "" : undefined}
                title={`${f.name ?? "No name in the recompiler"} (value ${f.value})`}
              >
                <span class="fmt">{formatLabel(f.name, f.value)}</span>
                <span class="pips" aria-label={[f.sampled && "sampled", f.buffer && "buffer", f.host && "Vulkan"].filter(Boolean).join(", ") || "not handled"}>
                  <i class:list={{ on: f.sampled }}>S</i>
                  <i class:list={{ on: f.buffer }}>B</i>
                  <i class:list={{ on: f.host }}>V</i>
                </span>
              </li>
            ))}
          </ul>
          <div class="descriptors">
            <p class="label">Image descriptor types</p>
            <ul>
              {coverage.descriptors.map((d) => (
                <li class:list={{ on: d.handled }}>
                  <span aria-hidden="true">{d.handled ? "✓" : "✕"}</span>
                  {d.name.replace(/^Color/, "")}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )
  }

  {
    (wantedFunctions.length > 0 || wantedErrors.length > 0) && (
      <section class="container block" id="wanted">
        <div class="card part">
          <header class="part-head">
            <div>
              <span class="eyebrow">Most wanted</span>
              <h2>What games are waiting on</h2>
              <p class="muted">
                Functions and errors named in each game's newest bring-up report that are still open in today's source, by how many games name them. Fixing one of these moves real games forward.
              </p>
            </div>
          </header>
          <div class="wanted-grid" style={`--rows:${Math.max(wantedFunctions.length, wantedErrors.length)}`}>
            {wantedFunctions.length > 0 && (
              <div>
                <p class="label">System functions</p>
                <ol class="wanted">
                  {wantedFunctions.map(({ item, games: slugs }) => (
                    <li>
                      <div>
                        <code>{item.name}</code>
                        <span class="muted">
                          {" "}
                          in <a href={`?library=${encodeURIComponent(item.library)}#libraries`}>{item.library}</a>
                          {item.status === "undeclared" && ", not declared yet"}
                        </span>
                      </div>
                      <span class="games">
                        {slugs.map((slug, i) => (
                          <>
                            {i > 0 && ", "}
                            <a href={`/compatibility/${slug}`}>{gameName.get(slug)}</a>
                          </>
                        ))}
                      </span>
                    </li>
                  ))}
                </ol>
              </div>
            )}
            {wantedErrors.length > 0 && (
              <div>
                <p class="label">Errors</p>
                <ol class="wanted">
                  {wantedErrors.map(({ item, games: slugs }) => (
                    <li>
                      <div>
                        <code class="message">{item.message}</code>
                      </div>
                      <span class="games">
                        {slugs.map((slug, i) => (
                          <>
                            {i > 0 && ", "}
                            <a href={`/compatibility/${slug}`}>{gameName.get(slug)}</a>
                          </>
                        ))}
                      </span>
                    </li>
                  ))}
                </ol>
              </div>
            )}
          </div>
        </div>
      </section>
    )
  }

  <section class="container block method" id="method">
    <div class="card part">
      <h2>How it's measured</h2>
      <div class="method-grid">
        <div>
          <h3>System libraries</h3>
          <p class="muted">
            From upstream's own <a href={`${REPO_URL}/blob/main/docs/dev/PROGRESS.md`}>progress report</a>: a function counts as implemented unless its body calls the not-implemented stub. No-op bodies are counted as implemented and shown separately.
          </p>
        </div>
        <div>
          <h3>Shader recompiler</h3>
          <p class="muted">
            Each build reads the recompiler's opcode tables, its DPP rules, its translator, its format tables and its error sites straight from upstream source, and compares them with AMD's machine-readable ISA. Earlier days are measured again with the same rules, so the charts stay comparable. If upstream reorganises this code, the build stops instead of publishing wrong numbers.
          </p>
        </div>
        <div>
          <h3>Not measured yet</h3>
          <p class="muted">
            Whether every operand modifier combination is accepted: VOP3 abs, neg, clamp and omod, op_sel, SDWA byte and word selects, and integer source modifiers inside DPP. Those are decided by code paths a source scan cannot follow; counting them needs a harness that runs the decoder itself.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  for (const group of document.querySelectorAll<HTMLElement>("[data-format-filter]")) {
    const list = group.closest(".part")!.querySelector<HTMLElement>("[data-formats]")!;
    group.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>("button[data-show]");
      if (!button) return;
      for (const b of group.querySelectorAll("button")) b.setAttribute("aria-pressed", String(b === button));
      const show = button.dataset.show!;
      for (const item of list.children as HTMLCollectionOf<HTMLElement>) {
        const handled = "sampled" in item.dataset || "buffer" in item.dataset || "host" in item.dataset;
        item.hidden = show === "all" ? false : show === "none" ? handled : !(show in item.dataset);
      }
    });
  }
</script>

