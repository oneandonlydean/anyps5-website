---
import Base from "../layouts/Base.astro";
import StageBadge from "../components/StageBadge.astro";
import StageBar from "../components/StageBar.astro";
---

<Base title="Page not found" unsearchable noindex>
  <section class="container lost">
    <div class="copy">
      <span class="eyebrow">404</span>
      <h1>This page never got past First draw</h1>
      <p class="lede">We relinked the link, resolved its imports and started it. Then nothing reached the screen. It may have moved, or the address is wrong.</p>
      <div class="ctas">
        <a class="button primary" href="/">Home</a>
        <button type="button" class="button" data-search-open>Search the site</button>
        <a class="button ghost" href="/compatibility">Compatibility</a>
      </div>
    </div>

    <div class="card game" aria-hidden="true">
      <div class="cover">
        <span class="glitch" data-text="404">404</span>
        <span class="scan"></span>
      </div>
      <div class="body">
        <b>Page Not Found</b>
        <span class="id mono">PPSA00404</span>
        <StageBar stage="First draw" size="md" />
        <StageBadge stage="First draw" />
        <code class="log">[gpu] presentation failed: no frame for this address</code>
      </div>
    </div>
  </section>
</Base>

<style>
  .lost {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
    padding-block: clamp(56px, 9vw, 120px);
  }
  .copy h1 {
    max-width: 14ch;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }
  .game {
    justify-self: center;
    width: min(320px, 100%);
    overflow: hidden;
    transform: rotate(3deg);
  }
  .cover {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background:
      radial-gradient(120% 90% at 30% 10%, color-mix(in srgb, var(--accent) 35%, var(--raised)), var(--bg)),
      var(--bg);
  }
  .glitch {
    position: relative;
    color: var(--text);
    font: 800 clamp(4rem, 9vw, 6rem) / 1 var(--display);
    letter-spacing: -0.04em;
  }
  /* Two offset copies in the accent colours, jittering like a frame that never finished drawing. */
  .glitch::before,
  .glitch::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    mix-blend-mode: screen;
  }
  .glitch::before {
    color: var(--accent);
    animation: jitter 2.4s steps(2) infinite;
  }
  .glitch::after {
    color: var(--accent-2);
    animation: jitter 1.9s steps(2) infinite reverse;
  }
  @keyframes jitter {
    0%,
    80%,
    100% {
      clip-path: inset(0 0 0 0);
      translate: 0 0;
    }
    84% {
      clip-path: inset(20% 0 55% 0);
      translate: -6px 0;
    }
    88% {
      clip-path: inset(60% 0 10% 0);
      translate: 5px 0;
    }
    92% {
      clip-path: inset(35% 0 40% 0);
      translate: -3px 0;
    }
  }
  .scan {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(to bottom, rgb(255 255 255 / 0.04) 0 1px, transparent 1px 4px);
    pointer-events: none;
  }
  .body {
    display: grid;
    gap: 10px;
    padding: 16px 18px 18px;
  }
  .body b {
    font-size: 1rem;
  }
  .id {
    margin-top: -6px;
    color: var(--faint);
    font-size: 0.78rem;
  }
  .body :global(.badge) {
    justify-self: start;
  }
  .log {
    padding: 8px 10px;
    border-radius: 6px;
    font-size: 0.72rem;
    color: var(--warn);
    white-space: normal;
  }
  @media (max-width: 800px) {
    .lost {
      grid-template-columns: 1fr;
    }
    .game {
      transform: none;
    }
  }
</style>
