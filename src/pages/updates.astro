---
import Base from "../layouts/Base.astro";
import StageBadge from "../components/StageBadge.astro";
import GameArt from "../components/GameArt.astro";
import { formatDate } from "../lib/site";
import { AREA_LABEL, AREAS, typeLabel } from "../lib/merges";
import { CATEGORY, getUpdates, type Update } from "../lib/updates";

const all = await getUpdates();
// Single merges are listed inside their day's digest rather than one by one.
const updates = all.filter((u) => u.kind !== "merge");
const days = Object.entries(Object.groupBy(updates, (u) => u.date.slice(0, 10))) as [string, Update[]][];
const VISIBLE_DAYS = 21;
// Merge lists are long (around 160 a day), so only the most recent days carry them.
const LISTED_DAYS = 7;
const listed = new Set(days.slice(0, LISTED_DAYS).map(([day]) => day));
const count = (category: string) => updates.filter((u) => CATEGORY[u.kind] === category).length;
const merges = all.filter((u) => u.kind === "merge").length;

const FEEDS = [
  { path: "/feeds/releases.xml", title: "Releases", text: "Each new AnyPS5 release. Good for an announcements channel." },
  { path: "/feeds/progress.xml", title: "Progress", text: "Every feature, fix and speed-up as it is merged, around 160 a day." },
  { path: "/feeds/progress-daily.xml", title: "Daily progress", text: "One summary a day of what was merged and what it added." },
  { path: "/feeds/libraries.xml", title: "Library milestones", text: "System libraries that get their first function, reach half, or are completed." },
  { path: "/feeds/games.xml", title: "Games", text: "Games that reach a new stage on the compatibility list." },
];
---

<Base title="Updates" description="New releases, games that moved up a stage, and every fix merged into AnyPS5, with feeds for each.">
  <section class="container page-head">
    <span class="eyebrow">Updates</span>
    <h1>What's new</h1>
    <p class="lede">Releases, games that moved up the ladder, and what was merged each day: {merges.toLocaleString("en-GB")} features, fixes and speed-ups in the last 30 days.</p>
  </section>

  <section class="container feeds" aria-labelledby="feeds-title">
    <h2 id="feeds-title" class="feeds-title">Follow in Discord or a feed reader</h2>
    <ul>
      {
        FEEDS.map((f) => (
          <li class="feed" title={f.text}>
            <a href={f.path}>
              <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor" aria-hidden="true"><path d="M5 17a2 2 0 1 1 0 4 2 2 0 0 1 0-4Zm-2-7a11 11 0 0 1 11 11h-3a8 8 0 0 0-8-8v-3Zm0-7a18 18 0 0 1 18 18h-3A15 15 0 0 0 3 6V3Z" /></svg>
              {f.title}
            </a>
            <button type="button" data-copy-feed={f.path} aria-label={`Copy the ${f.title} feed link`}>
              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2" /><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" /></svg>
            </button>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container timeline" data-updates>
    <div class="chips" role="group" aria-label="Show">
      <button type="button" aria-pressed="true" data-category="all">All</button>
      <button type="button" aria-pressed="false" data-category="releases">Releases {count("releases")}</button>
      <button type="button" aria-pressed="false" data-category="progress" id="progress">Progress {count("progress")}</button>
      <button type="button" aria-pressed="false" data-category="games">Games {count("games")}</button>
    </div>

    {
      days.map(([day, items], i) => (
        <section class="day" hidden={i >= VISIBLE_DAYS} data-day>
          <h2>
            <time datetime={day}>{formatDate(day)}</time>
          </h2>
          <ul>
            {items.map((u) =>
              u.kind === "digest" ? (
                <li class="item digest" data-category="progress" id={u.id}>
                  <details>
                    <summary>
                      <span class="thumb icon" aria-hidden="true">↗</span>
                      <span class="copy">
                        <b>{u.title}</b>
                        <span class="muted">{u.text}</span>
                      </span>
                      {listed.has(day) && <span class="toggle" aria-hidden="true" />}
                    </summary>
                    {listed.has(day) && (
                      <div class="merges">
                        {AREAS.map((area) => {
                          const list = (u.merges ?? []).filter((m) => m.area === area);
                          return list.length > 0 && (
                            <section class="area">
                              <h3>
                                {AREA_LABEL[area]} <span class="muted">{list.length}</span>
                              </h3>
                              <ul>
                                {list.map((m) => (
                                  <li class:list={["merge", m.type]}>
                                    <span class="type">{typeLabel(m.type)}</span>
                                    <a href={m.url}>
                                      {m.library && <span class="lib">{m.library}</span>}
                                      {m.summary}
                                    </a>
                                    <span class="by muted">
                                      #{m.number}
                                      {m.author && ` · ${m.author}`}
                                    </span>
                                  </li>
                                ))}
                              </ul>
                            </section>
                          );
                        })}
                      </div>
                    )}
                  </details>
                </li>
              ) : (
                <li class:list={["item", u.kind]} data-category={CATEGORY[u.kind]} id={u.id}>
                  <a href={u.url}>
                    {u.game ? (
                      <span class="art-thumb">
                        <GameArt name={u.game.name} src={u.game.cover} color={u.game.color} ratio="2/3" widths={[96]} sizes="36px" />
                      </span>
                    ) : (
                      <span class:list={["thumb icon", u.kind]} aria-hidden="true">
                        {u.kind === "release" ? "★" : u.kind === "retest" ? "↻" : u.kind === "library" ? (u.milestone === "complete" ? "✓" : "◐") : "↗"}
                      </span>
                    )}
                    <span class="copy">
                      <b>{u.title}</b>
                      <span class="muted">{u.text}</span>
                    </span>
                    {u.stage && <StageBadge stage={u.stage} />}
                  </a>
                </li>
              ),
            )}
          </ul>
        </section>
      ))
    }
    {
      days.length > VISIBLE_DAYS && (
        <button type="button" class="button more" data-more>
          Show older updates
        </button>
      )
    }
  </section>
</Base>

<script>
  const root = document.querySelector<HTMLElement>("[data-updates]")!;
  const days = [...root.querySelectorAll<HTMLElement>("[data-day]")];
  const chips = [...root.querySelectorAll<HTMLButtonElement>(".chips button")];

  const show = (category: string) => {
    chips.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.category === category)));
    for (const day of days) {
      let visible = 0;
      for (const item of day.querySelectorAll<HTMLElement>(":scope > ul > [data-category]")) {
        item.hidden = category !== "all" && item.dataset.category !== category;
        if (!item.hidden) visible++;
      }
      day.classList.toggle("empty", visible === 0);
    }
  };

  root.querySelector(".chips")!.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("button[data-category]");
    if (button) show(button.dataset.category!);
  });
  // /updates#progress (where the daily feed links) opens on the progress tab.
  if (location.hash === "#progress") show("progress");

  root.querySelector("[data-more]")?.addEventListener("click", (event) => {
    days.forEach((d) => (d.hidden = false));
    (event.currentTarget as HTMLElement).remove();
  });

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy-feed]")) {
    button.addEventListener("click", async () => {
      const url = new URL(button.dataset.copyFeed!, location.origin).href;
      try {
        await navigator.clipboard.writeText(url);
        document.dispatchEvent(new CustomEvent("toast", { detail: "Feed link copied" }));
      } catch {
        document.dispatchEvent(new CustomEvent("toast", { detail: url }));
      }
    });
  }
</script>

<style>
  .feeds {
    margin-bottom: 40px;
  }
  .feeds-title {
    margin: 0 0 12px;
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 600;
  }
  .feeds ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .feed {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.82rem;
  }
  .feed a,
  .feed button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
  }
  .feed a {
    padding: 5px 8px 5px 12px;
    font-weight: 600;
    text-decoration: none;
  }
  .feed button {
    padding: 5px 10px 5px 8px;
    border: 0;
    border-left: 1px solid var(--line);
    background: none;
    cursor: pointer;
  }
  .feed a:hover,
  .feed button:hover {
    color: var(--text);
  }

  .timeline {
    padding-bottom: 96px;
  }
  .timeline > * {
    max-width: 900px;
  }
  /* One row always: a pill-shaped bar that wraps looks broken, so on a narrow phone it scrolls sideways instead. */
  .chips {
    display: inline-flex;
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
    gap: 4px;
    margin-bottom: 28px;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
  }
  .chips button {
    flex: none;
    height: 34px;
    padding: 0 clamp(10px, 3vw, 14px);
    white-space: nowrap;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--muted);
    font: 500 0.86rem var(--font);
    cursor: pointer;
  }
  .chips button[aria-pressed="true"] {
    background: var(--raised);
    color: var(--text);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  .day {
    position: relative;
    padding: 0 0 22px 22px;
    border-left: 1px solid var(--line);
  }
  .day.empty {
    display: none;
  }
  .day::before {
    content: "";
    position: absolute;
    left: -5px;
    top: 6px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--bg);
  }
  .day > h2 {
    margin: 0 0 10px;
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0;
  }
  .day > ul {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .item > a,
  .item summary {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 14px 10px 10px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    transition:
      border-color 0.2s,
      transform 0.2s var(--ease);
  }
  .item > a:hover,
  .item summary:hover {
    border-color: var(--line-strong);
    color: var(--text);
  }
  .item > a:hover {
    transform: translateX(2px);
  }
  .item summary {
    cursor: pointer;
    list-style: none;
  }
  .item summary::-webkit-details-marker {
    display: none;
  }
  .item details[open] summary {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
  }
  .toggle {
    flex: none;
    width: 9px;
    height: 9px;
    margin-right: 4px;
    border-right: 2px solid var(--muted);
    border-bottom: 2px solid var(--muted);
    rotate: 45deg;
    translate: 0 -2px;
    transition: rotate 0.2s var(--ease);
  }
  details[open] .toggle {
    rotate: 225deg;
    translate: 0 2px;
  }
  .thumb {
    flex: none;
    display: grid;
    place-items: center;
    width: 36px;
    height: 54px;
    overflow: hidden;
    border-radius: 6px;
    background: var(--tint);
  }
  .art-thumb {
    flex: none;
    width: 36px;
    overflow: hidden;
    border-radius: 6px;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .thumb.icon {
    height: 36px;
    background: color-mix(in srgb, var(--accent) 16%, var(--surface));
    color: var(--accent-strong);
    font-size: 1rem;
  }
  .digest .thumb.icon,
  .thumb.icon.week {
    background: color-mix(in srgb, var(--accent-2) 16%, var(--surface));
    color: var(--accent-2);
  }
  .thumb.icon.library {
    background: color-mix(in srgb, var(--good) 16%, var(--surface));
    color: var(--good);
  }
  .copy {
    display: grid;
    flex: 1;
    min-width: 0;
    font-size: 0.9rem;
  }
  .copy b {
    font-weight: 600;
  }
  .copy .muted {
    font-size: 0.84rem;
  }

  /* A day's merges, grouped by area. */
  .merges {
    display: grid;
    gap: 18px;
    padding: 16px 16px 18px;
    border: 1px solid var(--line);
    border-top: 0;
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);
    background: color-mix(in srgb, var(--surface) 60%, transparent);
  }
  .area h3 {
    margin: 0 0 8px;
    font-size: 0.82rem;
  }
  .area ul {
    display: grid;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .merge {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 10px;
    font-size: 0.84rem;
  }
  .type {
    justify-self: start;
    padding: 1px 7px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    color: var(--accent-strong);
    font: 600 0.68rem var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .merge.fix .type {
    background: color-mix(in srgb, var(--good) 14%, transparent);
    color: var(--good);
  }
  .merge.perf .type {
    background: color-mix(in srgb, var(--warn) 16%, transparent);
    color: var(--warn);
  }
  .merge a {
    overflow: hidden;
    color: var(--text);
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .merge a:hover {
    text-decoration: underline;
  }
  .lib {
    margin-right: 6px;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.78rem;
  }
  .by {
    font-size: 0.76rem;
    white-space: nowrap;
  }
  .more {
    margin-top: 8px;
  }
  @media (max-width: 560px) {
    .item :global(.badge) {
      display: none;
    }
    .merge {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
    }
    .type {
      display: none;
    }
  }
</style>
