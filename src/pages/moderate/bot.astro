---
import Base from "../../layouts/Base.astro";
// The definitions Discord gets, so this page lists exactly what is registered.
import { COMMANDS, PUBLIC_REPLIES } from "../../../worker/scripts/commands.mjs";

/**
 * Every Discord bot command and what it does, for maintainers. Not linked from anywhere and kept out of search; hand
 * out the address. Names, descriptions and options come from worker/scripts/commands.mjs; the notes below add what a
 * maintainer needs to know about each.
 */

interface Choice {
  name: string;
  value: string;
}
interface CommandOption {
  type: number;
  name: string;
  description: string;
  required?: boolean;
  choices?: Choice[];
}
interface Command {
  name: string;
  description: string;
  options?: CommandOption[];
}

type Reply = "picture" | "text";
interface Note {
  group: (typeof GROUPS)[number][0];
  reply: Reply;
  /**
   * The whole channel sees what it posts, though the command isn't in PUBLIC_REPLIES (a server tool that posts by
   * itself). Otherwise only the person who ran it sees the answer.
   */
  everyone?: boolean;
  /** Answered from the site's data, so as current as the last site build; otherwise live. */
  live?: boolean;
  text: string;
}

const GROUPS = [
  ["games", "Games", "The compatibility list, from the bot."],
  ["progress", "Progress and news", "How far AnyPS5 has come, and what changed."],
  ["people", "People", "Contributors and testers."],
  ["help", "Help and the server", "Answers for newcomers, and the server rules."],
  ["moderation", "Moderation", "For members with the matching permission (Ban Members, Kick Members, Timeout Members, Manage Messages or Manage Channels). A moderator can only act on members whose highest role is below theirs. Each action is a numbered case, the member is told by direct message, and the case goes to the moderation log."],
  ["admin", "Server setup", "Only administrators see these, unless an admin lets another role use them in Server Settings → Integrations → the bot."],
] as const;

const NOTES: Record<string, Note> = {
  game: { group: "games", reply: "picture", text: "Stage, title IDs, last test and what stops it, with the game's picture. Games are suggested as you type." },
  games: {
    group: "games",
    reply: "text",
    text: "Games at a stage or further. With a GPU or OS it uses only reports on that system, so a game can show a different stage there than on the list.",
  },
  screenshot: { group: "games", reply: "picture", text: "A random community screenshot, crediting who took it. Only games with screenshots are suggested. Hide a bad one from Moderation." },
  report: { group: "games", reply: "text", text: "Points to the game's bring-up thread and the run report upload page." },
  follow: {
    group: "games",
    reply: "text",
    live: true,
    text: "A direct message when the game reaches a new stage. Up to 25 games each; the member needs direct messages from server members allowed.",
  },
  unfollow: { group: "games", reply: "text", live: true, text: "Stops those messages. Only followed games are suggested." },
  following: { group: "games", reply: "text", live: true, text: "The games someone follows, with their stages now." },
  progress: { group: "progress", reply: "picture", text: "Everything at a glance, or libraries, shaders or games in depth. Each has its own picture." },
  progressmap: { group: "progress", reply: "picture", text: "Upstream's progress map of every library function, as an image." },
  library: { group: "progress", reply: "picture", text: "One system library's progress and the games waiting on it. Libraries are suggested as you type." },
  wanted: { group: "progress", reply: "picture", text: "The missing functions most games are stuck on, as on the progress page." },
  release: { group: "progress", reply: "picture", text: "The latest release and its downloads." },
  tracked: { group: "progress", reply: "picture", text: "How the tracked games do on the latest release, and which haven't been run on it." },
  recent: {
    group: "progress",
    reply: "text",
    text: "The Updates page for the last day, week or month: stage changes, releases, daily progress and library milestones. Single merges are left out; the daily summary covers them.",
  },
  stats: { group: "progress", reply: "picture", text: "The project in numbers: merges, contributors, testing, libraries and shaders." },
  leaderboard: {
    group: "people",
    reply: "picture",
    live: true,
    text: "Contributors by merged pull requests, or testers by reports and uploads, for all time, 30 days or 7 days. Linked members show their Discord name, without being pinged.",
  },
  profile: {
    group: "people",
    reply: "text",
    live: true,
    text: "Someone's merged pull requests and test reports, and where they rank in each. Works for a linked member, or anyone by GitHub login.",
  },
  prs: { group: "people", reply: "text", live: true, text: "A linked member's merged pull request count and latest merges." },
  help: { group: "help", reply: "text", text: "Every command the member can use, by group. Moderation and server setup commands show only to members with the permission they need." },
  votekick: {
    group: "help",
    reply: "text",
    everyone: true,
    live: true,
    text: "Starts a public vote to silence a member for 24 hours or ban them for 2 weeks, for when no moderator is around. It passes at 5 yes votes (or the number set with /votekicks) with twice as many yes as no, within 10 minutes; the starter's vote counts. Only members here for 2 weeks can start or vote, moderators can't be voted on, and the mod role is pinged and can cancel. A passed vote is a case by \"a community vote\" in the moderation log, with who voted; the bot lifts the ban after 2 weeks.",
  },
  setup: { group: "help", reply: "text", text: "The setup guide in short: all six steps, or one step's sections with commands and links. Edits to the guide reach the bot at the next build." },
  error: {
    group: "help",
    reply: "text",
    text: "Paste the line a game printed, or a function name. It says whether main implements the function, where the source raises the error, and which games it stops. When nothing matches, only the asker sees that.",
  },
  faq: { group: "help", reply: "text", text: "Answers from the site's FAQ and from data/bot.yaml. Topics are suggested as you type." },
  rules: { group: "help", reply: "text", text: "The server rules, from data/bot.yaml." },
  rule: { group: "help", reply: "text", text: "One rule by number, to point someone at it. Rules are suggested by number or title." },
  ban: { group: "moderation", reply: "text", live: true, text: "Bans a member, or anyone by ID, and can delete their last hour, day or week of messages. They're told why before the ban." },
  unban: { group: "moderation", reply: "text", live: true, text: "Lifts a ban. Paste the user's ID into the user field." },
  kick: { group: "moderation", reply: "text", live: true, text: "Removes a member; they can join again with an invite. They're told why first." },
  timeout: { group: "moderation", reply: "text", live: true, text: "Discord's timeout: they can read but not talk, for up to 28 days. Durations like 10m, 1h30m, 2d or 1w." },
  untimeout: { group: "moderation", reply: "text", live: true, text: "Ends a timeout early." },
  warn: { group: "moderation", reply: "text", live: true, text: "A warning on the member's record, with a reason they're sent." },
  warnings: { group: "moderation", reply: "text", live: true, text: "A member's record: active warnings and every case, newest first." },
  unwarn: { group: "moderation", reply: "text", live: true, text: "Takes back a warning or timeout by case number, so it no longer counts toward automod's ladder. The case stays on the record, marked as taken back." },
  purge: { group: "moderation", reply: "text", live: true, text: "Deletes up to 100 recent messages in the channel, or only one member's. Pinned messages and ones older than 14 days are kept; Discord won't bulk delete those." },
  slowmode: { group: "moderation", reply: "text", live: true, text: "How long members wait between messages in a channel, from off to 6 hours." },
  lock: { group: "moderation", reply: "text", live: true, text: "Stops @everyone posting in a channel and says so there. Administrators and roles explicitly allowed in the channel can still post." },
  unlock: { group: "moderation", reply: "text", live: true, text: "Opens a locked channel again." },
  roles: {
    group: "admin",
    reply: "text",
    live: true,
    text: "Role panels, Carl-bot's reaction roles with buttons or a menu. Create posts a panel (title and description in a form); add puts roles on it, with an emoji and a few words each. Modes: toggle, unique (one at a time) or add only. Roles with moderation permissions are refused, and the bot's role must be above the roles it hands out.",
  },
  tag: { group: "help", reply: "text", everyone: true, live: true, text: "Posts a saved reply for the whole channel. Tags are suggested as you type; anyone can use them." },
  tags: { group: "admin", reply: "text", live: true, text: "Saving, changing and deleting the replies /tag posts, for members who can manage messages. Up to 200 per server." },
  votekicks: {
    group: "admin",
    reply: "text",
    live: true,
    text: "Turns community votes on (with the mod role to ping, the yes votes needed and an optional voter role) or off, and picks the channels they can be started in. Off until an admin turns it on.",
  },
  logs: {
    group: "admin",
    reply: "text",
    live: true,
    text: "Log channels: edited and deleted messages (with what they said), joins and leaves (with account age), nickname and role changes, and moderation cases, including bans made outside the bot.",
  },
  welcome: { group: "admin", reply: "text", live: true, text: "Welcome and goodbye messages, written in a form. {user} mentions them, {username} and {server} are names, {count} is the member count. Members who must accept the rules are welcomed once they do." },
  autorole: { group: "admin", reply: "text", live: true, text: "Roles every new member gets on joining, or on accepting the rules. Up to 10." },
  automod: {
    group: "admin",
    reply: "text",
    live: true,
    text: "Replaces Discord's keyword and regex rules. Scams (crypto, fake giveaways, phishing), piracy requests, hidden links (shorteners, base64), ETA questions, the same message in several channels, invites, mass mentions, and more. Text is read through look-alike letters, spaced-out letters and leetspeak; quotes of the server rules are never caught, and a single weak word (\"bitcoin\", \"torrent\") isn't enough. A strike is a public warning in the channel (only ever one), then a 24-hour timeout, then a ban; hacked-account patterns skip the warning. ETA questions are removed and answered from the FAQ. Setup turns on the recommended filters; test shows what would happen to a message. Moderators, and ignored channels and roles, are never checked.",
  },
  sticky: {
    group: "admin",
    reply: "text",
    live: true,
    text: "Keeps a message at the bottom of the channel it's run in. Set opens a form for the text (up to 2,000 characters; mentions never ping). A few seconds after anyone posts there, the bot posts the sticky again below and deletes the old copy; a check every minute catches anything missed. Up to 10 per server; the bot needs View Channel, Send Messages and Read Message History in the channel.",
  },
};

const commands = COMMANDS as Command[];
/** Within a group, commands in the order of NOTES, so related ones sit together. */
const ORDER = Object.keys(NOTES);
const missing = commands.filter((c) => !NOTES[c.name]).map((c) => c.name);
if (missing.length) throw new Error(`src/pages/moderate/bot.astro has no notes for /${missing.join(", /")}`);

/** Subcommands (option type 1) read as alternatives, like /sticky set|remove; other options as <required> [optional]. */
const usage = (c: Command) =>
  c.options?.every((o) => o.type === 1 || o.type === 2)
    ? `/${c.name} ${c.options.map((o) => o.name).join("|")}`
    : [`/${c.name}`, ...(c.options ?? []).map((o) => (o.required ? `<${o.name}>` : `[${o.name}]`))].join(" ");
const KINDS: Record<number, string> = { 4: "a number", 6: "a member", 7: "a channel", 8: "a role" };
const kind = (o: CommandOption) => (o.choices ? o.choices.map((c) => c.name).join(", ") : (KINDS[o.type] ?? "text"));

const POSTS = [
  ["Merges", "Each merged feature, fix or speed-up goes to the progress channel; anything else to the dev channel, if one is set. A linked author is pinged."],
  ["Releases", "A new release, once, in the releases channel."],
  ["Games", "A game reaching a new stage, in the games channel. Members following it get a direct message."],
  ["Daily summary", "Yesterday's progress, posted after 01:00 UTC, with library milestones unless they have a channel of their own."],
  ["Weekly summary", "From Monday 01:00 UTC: libraries, shaders and games against the week before, what moved up and what was merged."],
] as const;
---

<Base title="Discord bot commands" description="Every AnyPS5 Discord bot command, for maintainers." unsearchable noindex>
  <section class="container page-head">
    <span class="eyebrow">Maintainers</span>
    <h1>Discord bot commands</h1>
    <p class="lede">All {commands.length} slash commands, what each answers with, and who sees the answer.</p>
    <ul class="legend">
      <li><span class="tag picture">Picture</span> answers with a card drawn at each site build</li>
      <li><span class="tag private">Only you</span> only the person who ran it sees the answer</li>
      <li><span class="tag live">Live</span> answered from the bot's own records; the rest are as current as the last site build</li>
    </ul>
  </section>

  <div class="container groups">
    {
      GROUPS.map(([key, title, intro]) => (
        <section class="card group" id={key}>
          <h2>{title}</h2>
          <p class="muted">{intro}</p>
          <dl>
            {commands
              .filter((c) => NOTES[c.name]!.group === key)
              .sort((a, b) => ORDER.indexOf(a.name) - ORDER.indexOf(b.name))
              .map((c) => {
                const note = NOTES[c.name]!;
                return (
                  <div class="command" id={c.name}>
                    <dt>
                      <code>{usage(c)}</code>
                      <span class="tags">
                        {note.reply === "picture" && <span class="tag picture">Picture</span>}
                        {!note.everyone && !PUBLIC_REPLIES.includes(c.name) && <span class="tag private">Only you</span>}
                        {note.live && <span class="tag live">Live</span>}
                      </span>
                    </dt>
                    <dd>
                      <p>{note.text}</p>
                      {c.options && c.options.length > 0 && (
                        <ul class="options">
                          {c.options.map((o) => (
                            <li>
                              <code>{o.name}</code>
                              {o.type > 2 && <span class="muted">{o.required ? "required" : "optional"}</span>} {o.description}
                              {(o.choices || o.type > 3) && <span class="muted"> · {kind(o)}</span>}
                            </li>
                          ))}
                        </ul>
                      )}
                    </dd>
                  </div>
                );
              })}
          </dl>
        </section>
      ))
    }

    <section class="card group" id="posts">
      <h2>What the bot posts by itself</h2>
      <p class="muted">Each kind goes to its own channel when one is set, otherwise to the bot's main channel.</p>
      <dl>
        {
          POSTS.map(([name, text]) => (
            <div class="command">
              <dt>
                <b>{name}</b>
              </dt>
              <dd>
                <p>{text}</p>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="card group" id="maintaining">
      <h2>Changing the bot</h2>
      <ul class="steps">
        <li><b>FAQ answers and rules</b> live in <code>data/bot.yaml</code>. Each rule is a paragraph that starts with its bold number and title, like <code>**3. Title.** Text</code>. They reach the bot at the next site build.</li>
        <li><b>Command names, descriptions and options</b> live in <code>worker/scripts/commands.mjs</code>. After changing them, deploy first, then register them again with <code>npm --prefix worker run register-commands</code>, which needs the bot token. This page updates from the same file.</li>
        <li><b>Pictures and answers</b> are rebuilt with the site, on every push and whenever upstream changes. Messages already posted keep their old picture.</li>
      </ul>
    </section>
  </div>
</Base>

<style>
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-size: 0.88rem;
  }
  .groups {
    display: grid;
    gap: 20px;
    padding-bottom: 96px;
  }
  .group {
    padding: clamp(20px, 3vw, 28px);
  }
  .group h2 {
    margin: 0 0 4px;
  }
  .group > .muted {
    margin: 0 0 12px;
  }
  dl {
    display: grid;
    margin: 0;
  }
  .command {
    display: grid;
    grid-template-columns: minmax(0, 260px) minmax(0, 1fr);
    gap: 6px 24px;
    padding: 14px 0;
    border-top: 1px solid var(--line);
    scroll-margin-top: 96px;
  }
  dt {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }
  dt code {
    font-size: 0.86rem;
    white-space: normal;
    overflow-wrap: anywhere;
  }
  dd {
    margin: 0;
  }
  dd p {
    margin: 0;
    font-size: 0.92rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .tag {
    padding: 1px 8px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .tag.picture {
    border-color: color-mix(in srgb, var(--accent) 50%, var(--line));
    color: var(--accent);
  }
  .tag.private {
    border-color: color-mix(in srgb, var(--warn) 50%, var(--line));
    color: var(--warn);
  }
  .tag.live {
    border-color: color-mix(in srgb, var(--good) 50%, var(--line));
    color: var(--good);
  }
  .options {
    display: grid;
    gap: 4px;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.85rem;
  }
  .options code {
    margin-right: 6px;
  }
  .steps {
    display: grid;
    gap: 10px;
    margin: 8px 0 0;
    padding-left: 18px;
    font-size: 0.92rem;
  }
  @media (max-width: 640px) {
    .command {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
