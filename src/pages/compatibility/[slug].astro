---
import LocalDate from "../../components/LocalDate.astro";
import Base from "../../layouts/Base.astro";
import GameArt from "../../components/GameArt.astro";
import StageBadge from "../../components/StageBadge.astro";
import NeedsPanel from "../../components/NeedsPanel.astro";
import Screenshots from "../../components/Screenshots.astro";
import ReportDialog from "../../components/ReportDialog.astro";
import MaintainerTools from "../../components/MaintainerTools.astro";
import NoteBlock from "../../components/NoteBlock.astro";
import StageHistory from "../../components/StageHistory.astro";
import StageLadder from "../../components/StageLadder.astro";
import { getBuilds, getGames, getNeeds, getRetest, getScreenshots, getTested } from "../../lib/data";
import { buildLabel, reportBuild, uploadBuild, type BuildInfo } from "../../lib/builds";
import type { Game } from "../../lib/resolve";
import { DISCORD_URL, formatDate } from "../../lib/site";
import { STAGES, stageSlug } from "../../lib/stages";
import { artSrc, artSrcset, PLATFORM_LABEL, reach, regionName, reportKey } from "../../lib/view";
import { CONFIRMATIONS_NEEDED } from "../../lib/uploads";
import { gameTheme } from "../../lib/color";
import { LIST_ITEM } from "../../lib/parse";

export async function getStaticPaths() {
  return (await getGames()).map((game) => ({ params: { slug: game.slug }, props: { game } }));
}

const { game } = Astro.props as { game: Game };
const { stage, onMain } = reach(game);
const needs = (await getNeeds()).get(game.slug);
const retest = (await getRetest()).get(game.slug)!;
const shots = (await getScreenshots()).get(game.slug) ?? [];
const [builds, tested] = await Promise.all([getBuilds(), getTested().then((t) => t.get(game.slug)!)]);
const firstRelease = builds.releases.at(-1)?.tag;
const label = (info: { release: string | null; exact: boolean }) => buildLabel(info, firstRelease);
// A row's build: marked when only its date placed it, as it may be a neighbouring release.
const rowLabel = (info: BuildInfo) => label(info);
const BY_DATE = "The report names no commit or release, so its build is placed by its date";
// A release's results take in the release and main up to the next one.
const group = (release: string | null) => (release ? `${release} or main after it` : label({ release: null, exact: false }));
const since = retest.releasesSince === 0 ? "the current release" : `${retest.releasesSince} release${retest.releasesSince === 1 ? "" : "s"} ago`;
const freshness = retest.lastTested
  ? retest.lastBuild && retest.lastBuild.basis !== "date"
    ? `Last tested on ${label(retest.lastBuild)} · ${since}`
    : `Last tested ${formatDate(retest.lastTested)} · ${retest.releasesSince === 0 ? "on the current release" : since}`
  : null;
// The first paragraph of the note shows; a longer write-up opens on request. A paragraph of list items is a list.
const [noteLead, ...noteRest] = (game.note?.split("\n\n") ?? []).map((p) => {
  const lines = p.split("\n");
  return lines.length > 1 ? { items: lines.map((l) => l.replace(LIST_ITEM, "")) } : { text: p };
});
const art = game.art;
// The page takes its accent colours from the game's art; near-grey art keeps the site's own.
const theme = gameTheme(art?.color);
const themeStyle =
  theme &&
  (["dark", "light"] as const)
    .flatMap((mode) => Object.entries(theme[mode]).map(([key, value]) => `--game-${mode}-${key}:${value}`))
    .join(";");
// A game released in several regions can have a thread per title ID; the busiest one takes new reports.
const [thread, ...otherThreads] = [...game.threads].sort((a, b) => b.comments - a.comments || a.number - b.number);
const replies = (n: number) => (n === 1 ? "1 reply" : `${n} replies`);
/** Pull requests listed under the ladder before "and N more". */
const BRANCH_PRS_SHOWN = 5;
const BUILD_LABEL = { main: "main", prs: "main + PRs", patched: "patched", unknown: "—" } as const;
// Discussions reports and run reports uploaded here, newest first, in one table; each row opens its full report.
const rows = [
  ...game.reports.map((r) => ({
    key: reportKey(r),
    href: r.url,
    date: r.date,
    stage: r.stage,
    os: r.platform as string | null,
    gpuVendor: r.gpuVendor,
    gpu: r.gpu,
    // A main build is named by its release; one with pull requests or patches by what it added.
    build: r.buildKind === "main" || r.buildKind === "unknown" ? (r.build ? rowLabel(reportBuild(r, builds)) : BUILD_LABEL[r.buildKind]) : (BUILD_LABEL[r.buildKind] as string),
    byDate: (r.buildKind === "main" || r.buildKind === "unknown") && Boolean(r.build) && reportBuild(r, builds).basis === "date",
    buildTitle: r.build ?? undefined,
    by: r.author,
    upload: undefined as number | undefined,
    stated: false,
  })),
  ...game.uploads.map((u) => ({
    key: `u${u.id}`,
    href: `?report=u${u.id}`,
    date: u.at,
    stage: u.stage,
    os: u.os,
    gpuVendor: u.gpuVendor,
    gpu: u.gpu ?? null,
    build: rowLabel(uploadBuild(u, builds)),
    byDate: uploadBuild(u, builds).basis === "date",
    buildTitle: u.commit ?? undefined,
    by: u.login as string | null,
    upload: u.id,
    stated: Boolean(u.stated),
  })),
].sort((a, b) => Date.parse(b.date) - Date.parse(a.date));
// What a search result shows: how far the game gets in plain words, how well tested that is, and its title ID, which
// people search by too. The stage's meaning is left out when it would make the text too long to show in full.
const description = (() => {
  const ids = game.titleIds.slice(0, 2).join(", ");
  if (!stage || !rows.length) return `${game.name} (${ids}) has no AnyPS5 test reports yet. Convert it to run natively on Linux or Windows, and report how far it gets.`;
  const reached = `Can ${game.name} run on PC? On AnyPS5 it reaches ${stage}${onMain ? "" : " with open pull requests"}`;
  const tested = `${rows.length === 1 ? "1 test report" : `${rows.length} test reports`}, the latest on ${formatDate(rows[0].date)}. ${ids}`;
  const meaning = STAGES.find((s) => s.name === stage)?.meaning.replace(/\.$/, "");
  const full = `${reached}: ${meaning?.replace(/^./, (c) => c.toLowerCase())}. ${tested}`;
  if (meaning && full.length <= 160) return full;
  return `${reached}. ${tested}`.length <= 160 ? `${reached}. ${tested}` : `${game.name} on AnyPS5: ${stage}. ${tested}`;
})();
---

<Base title={game.name} description={description} image={`/og/${game.slug}.jpg`}>
  <link slot="head" rel="alternate" type="application/atom+xml" title={`${game.name} on AnyPS5`} href={`/compatibility/${game.slug}.xml`} />
  <div class:list={{ themed: theme }} style={themeStyle}>
    <section class="hero" style={`--tint:${art?.color ?? "var(--bg-glow)"}`}>
      {/* The backdrop sits dimmed behind a gradient, so phones get a smaller file than its width would ask for. */}
      {/* The scrim lives inside the backdrop, so the two morph together from a home-page feature. */}
      <div class="backdrop" data-vt-peer={art?.hero ? `hero-${game.slug}` : undefined}>
        {art?.hero && <img src={artSrc(art.hero, 1920)} srcset={artSrcset(art.hero, [640, 1280, 1920])} sizes="(max-width: 800px) 60vw, 100vw" alt="" fetchpriority="high" decoding="async" />}
      </div>
      <div class="container hero-inner" data-vt-with={art?.hero ? `hero-${game.slug}` : undefined}>
        <GameArt class="cover" name={game.name} src={art?.cover ?? art?.square ?? null} color={art?.color} ratio="2/3" widths={[240, 360, 480]} sizes="240px" eager peerTransitionName={`cover-${game.slug}`} />
        <div class="headline">
          <a class="back" href="/compatibility">← All games</a>
          {
            art?.logo ? (
              <h1 class="logo">
                <img src={artSrc(art.logo, 800)} alt={game.name} decoding="async" />
              </h1>
            ) : (
              <h1>{game.name}</h1>
            )
          }
          <div class="meta">
            <StageBadge stage={stage} onMain={onMain} />
            {game.verified && <span class="tag verified">✓ Checked by a maintainer</span>}
            {game.releases.map((r) => (
              <span class="tag mono" title={regionName(r.region) ?? undefined}>
                {r.titleId}
              </span>
            ))}
            {game.kind !== "retail" && <span class="tag">{game.kind === "homebrew" ? "Homebrew" : "App"}</span>}
            {freshness && <span class:list={["tag", { stale: retest.stale }]}>{freshness}</span>}
          </div>
          <MaintainerTools gameKey={game.key} />
        </div>
      </div>
    </section>

    <div class="container layout">
      <div class="main">
        {
          (retest.ready || retest.stale) && (
            <section class:list={["card panel retest", { ready: retest.ready }]}>
              <div>
                <h2>{retest.ready ? "Ready to retest" : "Due a fresh run"}</h2>
                {retest.ready ? (
                  <p>
                    What stopped it last time has been fixed since the report of <LocalDate iso={retest.lastTested!} />:
                    {retest.fixed.functions.length > 0 && <> {retest.fixed.functions.length} named function{retest.fixed.functions.length === 1 ? " is" : "s are"} implemented now</>}
                    {retest.fixed.functions.length > 0 && retest.fixed.issues.length > 0 && ","}
                    {retest.fixed.issues.length > 0 && (
                      <>
                        {" "}
                        {retest.fixed.issues.slice(0, 4).map((i, n) => (
                          <>
                            {n > 0 && ", "}
                            <a href={i.url}>#{i.number}</a> {i.state}
                          </>
                        ))}
                        {retest.fixed.issues.length > 4 && <> and {retest.fixed.issues.length - 4} more</>}
                      </>
                    )}
                    . A new run will show how much further it gets.
                  </p>
                ) : (
                  <p>The newest report is from <LocalDate iso={retest.lastTested!} />{retest.releasesSince > 1 ? `, ${retest.releasesSince} releases ago` : ""}. A run on the current build would keep this page accurate.</p>
                )}
              </div>
              <a class="button primary" href={`/report?game=${game.slug}`}>
                Test it and report
              </a>
            </section>
          )
        }
        <section class="card panel">
          <h2>Progress</h2>
          <StageLadder stage={game.stage} branchStage={game.branchStage} platforms={game.platforms} />
          {game.branch && (
            <div class="branch-needs">
              <p class="hint">
                Striped steps are reached only with changes not yet on <code>main</code>.{" "}
                {game.branch.prs.length > 0 ? <>The <a href={game.branch.url}>report</a> that got to {game.branchStage} used:</> : <>The <a href={game.branch.url}>report</a> that got to {game.branchStage} describes its local patches.</>}
              </p>
              {game.branch.prs.length > 0 && (
                <ul class="blockers branch-prs">
                  {game.branch.prs.slice(0, BRANCH_PRS_SHOWN).map((p) => (
                    <li>
                      <span class:list={["state", "pr", p.state]}>{p.state === "open" ? "Open PR" : p.state === "merged" ? "Merged since" : "Closed"}</span>
                      <a href={p.url}>
                        <span class="num">#{p.number}</span> {p.title}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
              {(game.branch.prs.length > BRANCH_PRS_SHOWN || (game.branch.patched && game.branch.prs.length > 0)) && (
                <p class="hint">
                  {game.branch.prs.length > BRANCH_PRS_SHOWN && <>And {game.branch.prs.length - BRANCH_PRS_SHOWN} more{game.branch.patched ? ", " : "."} </>}
                  {game.branch.patched && <>{game.branch.prs.length > BRANCH_PRS_SHOWN ? "plus" : "Plus"} local changes listed in the report.</>}
                </p>
              )}
              {!game.branch.patched && game.branch.prs.length > 0 && game.branch.prs.every((p) => p.state === "merged") && (
                <p class="hint">All of these have merged since, so <code>main</code> may get there now. A new run would show it.</p>
              )}
            </div>
          )}
        </section>

        {shots.length > 0 && <Screenshots shots={shots} game={game.name} />}

        {
          (game.note || game.blockers.length > 0) && (
            <section class="card panel">
              <h2>Where it stops</h2>
              {noteLead && <NoteBlock block={noteLead} />}
              {noteRest.length > 0 && (
                <details class="note-more">
                  <summary>Read the rest</summary>
                  {noteRest.map((block) => (
                    <NoteBlock block={block} />
                  ))}
                </details>
              )}
              {game.noteFrom && (
                <p class="note-from">
                  <a href={game.noteFrom.url}>{game.noteFrom.author ? `From ${game.noteFrom.author}'s report` : "From the report"} →</a>
                </p>
              )}
              {game.blockers.length > 0 && (
                <ul class="blockers">
                  {game.blockers.map((b) => (
                    <li>
                      <span class:list={["state", b.kind]}>{b.kind === "pr" ? "Open PR" : "Open issue"}</span>
                      <a href={b.url}>
                        <span class="num">#{b.number}</span> {b.title}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          )
        }

        {needs && <NeedsPanel needs={needs} />}

        {
          tested.releases.length > 0 && (
            <section class="card panel" id="releases">
              <h2>By release</h2>
              {tested.regression && (
                <p class="regression">
                  <b>Reported lower on a newer build.</b> On {group(tested.regression.now.release)} it reached {tested.regression.now.stage}; on{" "}
                  {group(tested.regression.was.release)} it reached {tested.regression.was.stage}. That can be a regression, or a different setup: another run on the current build would tell.
                </p>
              )}
              <div class="table-wrap">
                <table class="reports by-release">
                  <thead>
                    <tr>
                      <th>Build</th>
                      <th>Furthest stage</th>
                      <th>Results</th>
                      <th>Latest</th>
                    </tr>
                  </thead>
                  <tbody>
                    {tested.releases.map((r) => (
                      <tr data-report={r.latest} title="Open the newest report on this build">
                        <td class="mono small">
                          {r.release ? <>{r.release}<span class="muted"> and main after</span></> : label({ release: null, exact: false })}
                          {r.approximate && <span class="muted" title="These results name no commit or release, so they are placed by their date"> (by date)</span>}
                        </td>
                        <td>
                          <StageBadge stage={r.stage} />
                        </td>
                        <td class="results">
                          {r.results}
                          <span class="phone-only"> {r.results === 1 ? "result" : "results"}</span>
                        </td>
                        <td class="nowrap">
                          <a href={`?report=${r.latest}`} data-open aria-haspopup="dialog">
                            <LocalDate iso={r.last} />
                          </a>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <p class="hint">Reports on main and uploaded runs, placed by the commit they were built from. Reports that needed open pull requests or patches are left out.</p>
            </section>
          )
        }

        {
          game.reports.filter((r) => r.stage).length > 1 && (
            <section class="card panel">
              <h2>History</h2>
              <StageHistory reports={game.reports} timeline={game.timeline} />
              {game.timeline.length > 1 && (
                <ol class="timeline">
                  {game.timeline.map((e) => (
                    <li style={`--tone:var(--stage-${stageSlug(e.stage)})`}>
                      <LocalDate iso={e.date} />
                      {e.url ? <a href={e.url}>Reached {e.stage}</a> : <span>Reached {e.stage} ({e.source === "uploads" ? "confirmed by uploaded run reports" : "checked by a maintainer"})</span>}
                    </li>
                  ))}
                </ol>
              )}
            </section>
          )
        }

        <section class="card panel">
          <h2>Test reports <span class="muted count">{rows.length}</span></h2>
          {
            game.autoStage && (
              <p class="upload-status">
                <StageBadge stage={game.autoStage.stage} />
                {game.autoStage.confirmed && game.autoStage.verifiedBy && game.autoStage.confirmations < CONFIRMATIONS_NEEDED ? (
                  <span>An uploaded run report reached this, checked and verified by maintainer {game.autoStage.verifiedBy}.</span>
                ) : game.autoStage.confirmed ? (
                  <span>Uploaded run reports reached this, confirmed by {game.autoStage.confirmations} {game.autoStage.confirmations === 1 ? "report" : "reports"}.</span>
                ) : (
                  <span class="muted">
                    An uploaded run report reached this: {game.autoStage.confirmations} of {CONFIRMATIONS_NEEDED} confirmations. It counts toward the game's stage once another tester confirms it.
                  </span>
                )}
              </p>
            )
          }
          {
            rows.length ? (
              <div class="table-wrap" data-pagefind-ignore>
                <table class="reports">
                  <thead>
                    <tr>
                      <th>Date</th>
                      <th>Stage</th>
                      <th>System</th>
                      <th>Build</th>
                      <th>By</th>
                    </tr>
                  </thead>
                  <tbody>
                    {rows.map((row) => (
                      <tr data-report={row.key}>
                        <td class="nowrap">
                          <a href={row.href} data-open aria-haspopup="dialog">
                            <LocalDate iso={row.date} />
                          </a>
                        </td>
                        <td>
                          <StageBadge stage={row.stage} />
                          {row.stated && <span class="muted small stated" title="The run report itself records up to Presents; the tester said it got this far. It counts once another tester confirms it.">unconfirmed</span>}
                        </td>
                        <td class="system">
                          {[row.os && (PLATFORM_LABEL[row.os as keyof typeof PLATFORM_LABEL] ?? row.os), row.gpuVendor].filter(Boolean).join(" · ") || "—"}
                        </td>
                        <td class="build" title={row.buildTitle}>
                          <span class="mono small">{row.build}</span>
                          {row.byDate && (
                            <span class="muted small by-date" title={BY_DATE}>
                              by date
                            </span>
                          )}
                        </td>
                        <td class="muted by" data-upload-id={row.upload}>
                          <span class="who">
                            {row.by ?? "—"}
                            {row.upload !== undefined && (
                              <span class="source" title="A run report uploaded on this site">
                                Run report
                              </span>
                            )}
                          </span>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ) : (
              <p class="muted">No structured reports yet. The discussion thread may still have notes.</p>
            )
          }
        </section>
        <ReportDialog game={game.name} reports={game.reports} uploads={game.uploads} />
      </div>

      <aside class="side">
        <div class="card panel actions">
          <a class="button primary" href={`/report?game=${game.slug}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V4M7 9l5-5 5 5M5 20h14" /></svg>
            Upload a run report
          </a>
          {
            [thread, ...otherThreads].filter(Boolean).map((t, i) => (
              <a class="button" href={t!.url}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12Z" /></svg>
                {i === 0 ? "Open discussion" : `Discussion #${t!.number}`}
                <span class="replies">{replies(t!.comments)}</span>
              </a>
            ))
          }
          <a class="button" href={`/compatibility/${game.slug}.xml`}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19h.01M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16" /></svg>
            Follow this game
            <span class="replies">Atom feed</span>
          </a>
          <a class="button subtle" href={DISCORD_URL}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16v4ZM13 7l4 4" /></svg>
            Suggest a correction
          </a>
        </div>

        <dl class="card panel facts">
          <div>
            <dt>{game.releases.length === 1 ? "Title ID" : "Title IDs"}</dt>
            <dd>
              <ul class="releases">
                {game.releases.map((r) => (
                  <li>
                    <span class="mono">{r.titleId}</span>
                    {r.region && <span class="muted">{regionName(r.region)}</span>}
                  </li>
                ))}
              </ul>
            </dd>
          </div>
          <div><dt>Reporters</dt><dd>{game.reporters}</dd></div>
          {game.gpuVendors.length > 0 && <div><dt>GPUs tested</dt><dd>{game.gpuVendors.join(", ")}</dd></div>}
          {game.updated && <div><dt>Last activity</dt><dd><LocalDate iso={game.updated} /></dd></div>}
          {game.aliases.length > 0 && <div><dt>Also known as</dt><dd>{game.aliases.join(", ")}</dd></div>}
        </dl>
      </aside>
    </div>
  </div>
</Base>

<style>
  /* Game accents from gameTheme(); custom properties resolve where they are declared, so the gradient is redone too. */
  .themed {
    --accent: var(--game-dark-accent);
    --accent-strong: var(--game-dark-strong);
    --accent-2: var(--game-dark-second);
    --gradient: linear-gradient(100deg, var(--accent), var(--accent-2));
  }
  :global(:root[data-theme="light"]) .themed {
    --accent: var(--game-light-accent);
    --accent-strong: var(--game-light-strong);
    --accent-2: var(--game-light-second);
  }
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(360px, 56vh, 600px);
    overflow: hidden;
    isolation: isolate;
    padding-block: clamp(48px, 8vw, 104px) 44px;
    background: radial-gradient(1000px 520px at 20% 0%, color-mix(in srgb, var(--tint) 55%, transparent), transparent 70%);
  }
  .hero > .container {
    width: 100%;
  }
  .backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    view-transition-class: hero-morph;
  }
  .backdrop img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    opacity: 0.7;
    animation: settle 1.2s var(--ease) both;
  }
  .backdrop::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, var(--bg) 4%, color-mix(in srgb, var(--bg) 50%, transparent) 50%, color-mix(in srgb, var(--bg) 10%, transparent)),
      linear-gradient(to right, color-mix(in srgb, var(--bg) 85%, transparent), transparent 65%),
      radial-gradient(800px 400px at 15% 100%, color-mix(in srgb, var(--tint) 30%, transparent), transparent);
  }
  @keyframes settle {
    from {
      transform: scale(1.06);
    }
  }
  .hero-inner {
    display: flex;
    align-items: flex-end;
    gap: clamp(20px, 4vw, 44px);
  }
  .hero :global(.cover) {
    flex: 0 0 clamp(120px, 20vw, 248px);
    border-radius: var(--radius);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.1),
      0 40px 80px -24px rgb(0 0 0 / 0.8),
      0 0 90px -30px var(--tint);
    animation: lift 0.9s var(--ease) both;
  }
  /* Arriving through a view transition, the cover and backdrop morph in from the previous page instead. */
  :global(.vt-arrived) .backdrop img,
  :global(.vt-arrived) .hero :global(.cover) {
    animation: none;
  }
  @keyframes lift {
    from {
      opacity: 0;
      transform: translateY(20px) scale(0.97);
    }
  }
  .headline {
    min-width: 0;
  }
  .back {
    display: inline-block;
    margin-bottom: 18px;
    color: var(--muted);
    font-size: 0.88rem;
    text-decoration: none;
  }
  .back:hover {
    color: var(--text);
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: 18px;
  }
