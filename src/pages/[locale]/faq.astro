---
import FaqPage from "../../components/FaqPage.astro";
import { TRANSLATED_LOCALES, type Locale } from "../../i18n";

export function getStaticPaths() {
  return TRANSLATED_LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
---

<FaqPage locale={locale} />
