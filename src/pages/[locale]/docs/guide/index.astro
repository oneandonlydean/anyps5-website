---
import GuideIndex from "../../../../components/guide/GuideIndex.astro";
import { TRANSLATED_LOCALES, type Locale } from "../../../../i18n";

export function getStaticPaths() {
  return TRANSLATED_LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
---

<GuideIndex locale={locale} />
