---
import type { GetStaticPaths } from "astro";
import Article from "../../layouts/Article.astro";
import { DOCS, renderDoc } from "../../lib/docs";
import { getSteps, guideNav } from "../../lib/guide";
import { getRelease } from "../../lib/upstream";

export const getStaticPaths = (() => DOCS.map((doc) => ({ params: { slug: doc.slug }, props: { doc } }))) satisfies GetStaticPaths;

const { doc } = Astro.props;
const [{ html, headings }, release] = await Promise.all([renderDoc(doc.file), getRelease()]);
---

<Article title={doc.title} eyebrow="Documentation" lede={doc.summary} nav={guideNav(await getSteps())} headings={headings}>
  {release && <p class="source">From the <a href={release.url}>{release.tag}</a> release. These pages update with every release.</p>}
  <Fragment set:html={html} />
</Article>

<style>
  .source {
    padding: 10px 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--muted);
    font-size: 0.88rem;
  }
</style>
