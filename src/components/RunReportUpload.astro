---
import { CONFIRMATIONS_NEEDED } from "../lib/uploads";

interface Props {
  /** Games on the compatibility list, for reports without a title ID (the uploader picks the game). */
  games: { name: string; ids: string[] }[];
}
const { games } = Astro.props;
---

<section class="card upload" id="upload" data-upload data-listed={JSON.stringify(games.flatMap((g) => g.ids))}>
  <div class="intro">
    <h2>Upload a run report</h2>
    <p class="muted">
      When a game stops, AnyPS5 writes <code>anyps5-report.json</code> next to it: how far it got, what it was missing, and why it stopped. Drop it here and your
      result goes on the compatibility list. A new stage counts once {CONFIRMATIONS_NEEDED} people have seen it, or one upload and a Discussions report agree.
    </p>
  </div>

  <div class="account" data-account>
    <span class="muted">Checking whether you're signed in…</span>
  </div>

  <div class="drop" data-drop hidden>
    <input type="file" accept=".json,application/json" id="report-file" data-file />
    <label for="report-file">
      <b>Choose anyps5-report.json</b>
      <span class="muted">or drop it here</span>
    </label>
    <div class="preview" data-preview hidden></div>
    <label class="pick" data-pick hidden>
      <span>This report doesn't say which game it was. Which game did you run? If it isn't on the list, type its title ID.</span>
      <input list="upload-games" placeholder="Game name or title ID" autocomplete="off" data-pick-input />
      <datalist id="upload-games">
        {games.map((g) => <option value={`${g.name} (${g.ids[0]})`} />)}
      </datalist>
    </label>
    <label class="pick" data-pick-name hidden>
      <span>That game isn't on the list yet. What is it called? A maintainer checks new games before they show.</span>
      <input placeholder="Game name" maxlength="120" autocomplete="off" data-pick-name-input />
    </label>
    <fieldset class="reached" data-reached hidden>
      <legend>How far did you get? The report can only tell up to frames on screen.</legend>
      <label><input type="radio" name="reached" value="" checked /> Logos, video or loading screens</label>
      <label><input type="radio" name="reached" value="menus" /> A menu or title screen that responds</label>
      <label><input type="radio" name="reached" value="ingame" /> Into gameplay</label>
      <label><input type="radio" name="reached" value="playable" /> Played it start to finish</label>
    </fieldset>
    <button type="button" class="button primary" data-send hidden>Upload report</button>
  </div>
  <div class="result" data-result role="status" aria-live="polite"></div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-upload]")!;
  const account = root.querySelector<HTMLElement>("[data-account]")!;
  const drop = root.querySelector<HTMLElement>("[data-drop]")!;
  const input = root.querySelector<HTMLInputElement>("[data-file]")!;
  const preview = root.querySelector<HTMLElement>("[data-preview]")!;
  const send = root.querySelector<HTMLButtonElement>("[data-send]")!;
  const result = root.querySelector<HTMLElement>("[data-result]")!;
  const pick = root.querySelector<HTMLElement>("[data-pick]")!;
  const pickInput = root.querySelector<HTMLInputElement>("[data-pick-input]")!;
  const pickName = root.querySelector<HTMLElement>("[data-pick-name]")!;
  const pickNameInput = root.querySelector<HTMLInputElement>("[data-pick-name-input]")!;
  const reached = root.querySelector<HTMLFieldSetElement>("[data-reached]")!;
  const reachedValue = () => (reached.hidden ? "" : (reached.querySelector<HTMLInputElement>("input:checked")?.value ?? ""));
  // Every listed title ID, regional variants too: the list shows only each game's first.
  const listed = new Set<string>(JSON.parse(root.dataset.listed ?? "[]"));
  // A picked game is sent as its title ID: "Name (PPSA12345)" or a bare ID. One not on the list needs a name too.
  const chosenId = () => (pick.hidden ? null : (pickInput.value.toUpperCase().match(/\b((?:PPSA|CUSA)\d{5})\)?\s*$/)?.[1] ?? null));
  pickInput.addEventListener("input", () => {
    const id = chosenId();
    pickName.hidden = !id || listed.has(id);
  });
  const MAX = 64 * 1024;
  let body: string | null = null;

  const el = (tag: string, text: string, className?: string) => {
    const node = document.createElement(tag);
    node.textContent = text;
    if (className) node.className = className;
    return node;
  };

  function showAccount(me: { signedIn: boolean; signInAvailable?: boolean; login?: string; avatar?: string; blocked?: boolean }) {
    account.replaceChildren();
    if (!me.signedIn) {
      if (me.signInAvailable === false) {
        account.append(el("span", "Uploading isn't switched on for this site yet.", "muted"));
        return;
      }
      const link = el("a", "Sign in with GitHub to upload", "button");
      (link as HTMLAnchorElement).href = `/auth/github?return=${encodeURIComponent(location.pathname + location.search)}`;
      account.append(link, el("span", "Reports are tied to your GitHub account, so nobody can upload in your name.", "muted note"));
      return;
    }
    if (me.avatar) {
      const img = document.createElement("img");
      img.src = me.avatar;
      img.alt = "";
      img.width = 24;
      img.height = 24;
      account.append(img);
    }
    account.append(el("span", `Signed in as ${me.login}`));
    const out = el("button", "Sign out", "linkish") as HTMLButtonElement;
    out.type = "button";
    out.addEventListener("click", async () => {
      await fetch("/auth/logout", { method: "POST" });
      location.reload();
    });
    account.append(out);
    if (me.blocked) account.append(el("span", "This account can't upload reports.", "muted"));
    else drop.hidden = false;
  }

  fetch("/api/me")
    .then((r) => (r.ok ? r.json() : { signedIn: false, signInAvailable: false }))
    .then(showAccount)
    .catch(() => showAccount({ signedIn: false, signInAvailable: false }));

  // A quick look in the browser first, so an obviously wrong file is caught before it is sent.
  async function choose(file: File | undefined) {
    result.replaceChildren();
    preview.hidden = send.hidden = reached.hidden = pick.hidden = pickName.hidden = true;
    body = null;
    if (!file) return;
    if (file.size > MAX) return result.append(el("p", "That file is too big for a run report (64 KB at most).", "bad"));
    const text = await file.text();
    let report: any;
    try {
      report = JSON.parse(text);
    } catch {
      return result.append(el("p", "That file isn't JSON. Choose the anyps5-report.json AnyPS5 wrote.", "bad"));
    }
    if (report?.format !== "anyps5-report") return result.append(el("p", "That isn't an AnyPS5 run report.", "bad"));
    body = text;
    const titleId: string | null = report.game?.titleId ?? null;
    const stage = report.run?.stage && report.run.stage !== "unknown" ? report.run.stage : "an unknown stage";
    preview.replaceChildren(
      el("b", titleId ? `${report.game?.name ?? "Unknown name"} (${titleId})` : "Game not recorded in the report"),
      el("span", `Reached ${stage} on ${report.system?.os ?? "an unknown OS"} with ${report.system?.gpu?.vendor ?? "an unknown GPU"}`, "muted"),
    );
    pick.hidden = titleId !== null;
    // Past frames on screen, only the person who played can say how far it got.
    reached.hidden = report.run?.stage !== "presents";
    reached.querySelector<HTMLInputElement>('input[value=""]')!.checked = true;
    pickInput.value = pickNameInput.value = "";
    pickName.hidden = true;
    preview.hidden = send.hidden = false;
  }

  input.addEventListener("change", () => choose(input.files?.[0]));
  drop.addEventListener("dragover", (event) => {
    event.preventDefault();
    drop.classList.add("over");
  });
  drop.addEventListener("dragleave", () => drop.classList.remove("over"));
  drop.addEventListener("drop", (event) => {
    event.preventDefault();
    drop.classList.remove("over");
    choose(event.dataTransfer?.files[0]);
  });

  send.addEventListener("click", async () => {
    if (!body) return;
    send.disabled = true;
    result.replaceChildren(el("p", "Uploading…", "muted"));
    const chosen = chosenId();
    const name = pickName.hidden ? "" : pickNameInput.value.trim();
    if (!pick.hidden && !chosen) {
      send.disabled = false;
      result.replaceChildren(el("p", "Choose the game from the list, or type its title ID (like PPSA12345).", "bad"));
      return;
    }
    if (!pickName.hidden && !name) {
      send.disabled = false;
      result.replaceChildren(el("p", "Give the game's name too.", "bad"));
      return;
    }
    const query = new URLSearchParams();
    if (chosen) query.set("titleId", chosen);
    if (name) query.set("name", name);
    if (reachedValue()) query.set("reached", reachedValue());
    let res: Response;
    try {
      res = await fetch(`/api/reports${query.size ? `?${query}` : ""}`, { method: "POST", headers: { "content-type": "application/json" }, body });
    } catch {
      send.disabled = false;
      result.replaceChildren(el("p", "The site couldn't be reached. Check your connection and try again.", "bad"));
      return;
    }
    const data = await res.json().catch(() => ({}));
    result.replaceChildren();
    send.disabled = false;
    if (res.ok) {
      const done = el(
        "p",
        data.status === "review"
          ? name
            ? "Thanks! A maintainer checks new games first; the game gets its page once they have."
            : "Thanks! Something in this report needs a maintainer to look at it first; it shows once they have."
          : "Thanks! Your report is in. The game's page shows it after the next update, in a few minutes.",
        "good",
      );
      const link = el("a", `Find ${data.titleId} on the compatibility list`) as HTMLAnchorElement;
      link.href = `/compatibility/?q=${encodeURIComponent(data.titleId)}`;
      result.append(done, link);
      preview.hidden = send.hidden = pick.hidden = pickName.hidden = reached.hidden = true;
      input.value = "";
      return;
    }
    result.append(el("p", data.error ?? "The upload didn't work. Try again.", "bad"));
    // The site's list can be newer than this page's: ask for what the server says is missing.
    if (data.needsName) pickName.hidden = false;
    if (data.needsGame) pick.hidden = false;
    if (Array.isArray(data.issues)) {
      const list = document.createElement("ul");
      for (const issue of data.issues) list.append(el("li", issue));
      result.append(list);
    }
  });
</script>

<style>
  .upload {
    display: grid;
    gap: 16px;
    margin-bottom: 24px;
    padding: clamp(20px, 3vw, 28px);
  }
  .upload h2 {
    margin: 0 0 6px;
    font-size: 1.15rem;
  }
  .intro p {
    margin: 0;
    font-size: 0.92rem;
  }
  .soon {
    margin-top: 8px !important;
    font-size: 0.84rem !important;
  }
  .account {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-size: 0.9rem;
  }
  .account :global(img) {
    border-radius: 50%;
  }
  .account :global(.note) {
    font-size: 0.82rem;
  }
  .account :global(.linkish) {
    padding: 0;
    border: 0;
    background: none;
    color: var(--accent);
    font: inherit;
    cursor: pointer;
  }
  .drop {
    display: grid;
    gap: 12px;
    justify-items: start;
    padding: 18px;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-sm);
    transition: border-color 0.2s, background 0.2s;
  }
  .drop[hidden] {
    display: none;
  }
  .drop.over {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 6%, transparent);
  }
  .drop input[type="file"] {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .drop label {
    display: grid;
    gap: 2px;
    cursor: pointer;
  }
  .drop input[type="file"]:focus-visible + label {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  .pick {
    display: grid;
    gap: 6px;
    width: min(100%, 460px);
    font-size: 0.88rem;
  }
  .pick[hidden] {
    display: none;
  }
  .pick input {
    height: 38px;
    padding: 0 12px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text);
    font: inherit;
  }
  .reached {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    border: 0;
    font-size: 0.88rem;
  }
  .reached[hidden] {
    display: none;
  }
  .reached legend {
    margin-bottom: 4px;
    padding: 0;
  }
  .reached label {
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .preview {
    display: grid;
    gap: 2px;
    font-size: 0.9rem;
  }
  .result :global(p) {
    margin: 0 0 6px;
    font-size: 0.9rem;
  }
  .result :global(.good) {
    color: var(--good);
  }
  .result :global(.bad) {
    color: var(--bad);
  }
  .result :global(ul) {
    margin: 0;
    padding-left: 18px;
    color: var(--muted);
    font-size: 0.85rem;
  }
</style>
