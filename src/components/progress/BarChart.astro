---
import { formatDate } from "../../lib/site";

interface Props {
  title: string;
  dates: string[];
  values: number[];
  unit: string;
  /** The last day is still in progress: drawn faded and labelled as a partial count. */
  partial?: boolean;
}

const { title, dates, values, unit, partial = false } = Astro.props;
const number = new Intl.NumberFormat("en-GB");

// A y-scale from zero to a round number just above the largest value, as LineChart does.
const peak = Math.max(1, ...values);
const magnitude = 10 ** Math.floor(Math.log10(peak));
const step = [1, 2, 2.5, 5, 10].map((m) => (m * magnitude) / 2).find((s) => peak / s <= 4)!;
const top = Math.ceil(peak / step) * step;
const ticks = Array.from({ length: Math.round(top / step) + 1 }, (_, i) => i * step);

const n = dates.length;
const centre = (i: number) => ((i + 0.5) / n) * 100;
const labels = n > 2 ? [0, Math.floor((n - 1) / 2), n - 1] : dates.map((_, i) => i);
const data = JSON.stringify({ dates: dates.map((d) => formatDate(d)), values, partial });
---

<figure class="chart" data-bar-chart={data} data-unit={unit} style={`--gap:${n > 120 ? 1 : 2}px`}>
  <figcaption><span class="title">{title}</span></figcaption>
  <div class="plot">
    <div class="y" aria-hidden="true" style={`--label:${Math.max(...ticks.map((t) => number.format(t).length))}ch`}>
      {ticks.map((t) => <span style={`bottom:${(t / top) * 100}%`}>{number.format(t)}</span>)}
    </div>
    <div class="area" role="img" aria-label={`${title}, ${n} days. A table follows.`}>
      {ticks.map((t) => <span class="grid" style={`bottom:${(t / top) * 100}%`} />)}
      <div class="bars">
        {values.map((v, i) => <span class:list={{ partial: partial && i === n - 1 }} style={`height:${(v / top) * 100}%`} />)}
      </div>
      <div class="tip" hidden role="status" />
    </div>
    <div class="x" aria-hidden="true">
      {labels.map((i) => <span style={`left:${centre(i)}%`}>{formatDate(dates[i])}</span>)}
    </div>
  </div>
  <details class="table" data-pagefind-ignore>
    <summary>Show as a table</summary>
    <div class="scroll">
      <table>
        <thead>
          <tr><th>Day (UTC)</th><th>Commits</th></tr>
        </thead>
        <tbody>
          {
            dates.map((d, i) => (
              <tr>
                <td>{formatDate(d)}{partial && i === n - 1 && " (so far)"}</td>
                <td>{number.format(values[i])}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </details>
</figure>

<script>
  const number = new Intl.NumberFormat("en-GB");
  for (const chart of document.querySelectorAll<HTMLElement>("[data-bar-chart]")) {
    const { dates, values, partial } = JSON.parse(chart.dataset.barChart!) as { dates: string[]; values: number[]; partial: boolean };
    const area = chart.querySelector<HTMLElement>(".area")!;
    const bars = [...area.querySelectorAll<HTMLElement>(".bars > span")];
    const tip = area.querySelector<HTMLElement>(".tip")!;
    let active: HTMLElement | undefined;

    const show = (clientX: number) => {
      const box = area.getBoundingClientRect();
      const i = Math.min(dates.length - 1, Math.max(0, Math.floor(((clientX - box.left) / box.width) * dates.length)));
      active?.classList.remove("active");
      active = bars[i];
      active.classList.add("active");
      const left = ((i + 0.5) / dates.length) * 100;
      tip.hidden = false;
      tip.replaceChildren();
      const head = document.createElement("b");
      head.textContent = dates[i];
      const row = document.createElement("span");
      row.textContent = `${number.format(values[i])} ${chart.dataset.unit}${partial && i === dates.length - 1 ? " so far" : ""}`;
      tip.append(head, row);
      tip.style.left = `${left}%`;
      tip.classList.toggle("flip", left > 60);
    };
    area.addEventListener("pointermove", (e) => show(e.clientX));
    area.addEventListener("pointerleave", () => {
      tip.hidden = true;
      active?.classList.remove("active");
    });
  }
</script>

<style>
  .chart {
    margin: 0;
  }
  figcaption {
    margin-bottom: 14px;
  }
  .title {
    font-weight: 600;
  }
  .plot {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: 200px auto;
    column-gap: 10px;
  }
  /* As wide as the longest label, in the labels' own font, so none of them hangs outside the card's padding. */
  .y {
    position: relative;
    min-width: var(--label, 3ch);
    font: 0.72rem var(--mono);
  }
  .y span {
    position: absolute;
    right: 0;
    translate: 0 50%;
    color: var(--faint);
    font: 0.72rem var(--mono);
    white-space: nowrap;
  }
  .area {
    position: relative;
    touch-action: pan-y;
  }
  .grid {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--line);
  }
  .bars {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    gap: var(--gap);
  }
  .bars span {
    flex: 1;
    min-width: 0;
    border-radius: min(4px, 30%) min(4px, 30%) 0 0;
    background: var(--accent);
    transition: opacity 120ms var(--ease);
  }
  .bars span.partial {
    opacity: 0.4;
  }
  .bars:has(.active) span:not(.active) {
    opacity: 0.55;
  }
  .bars:has(.active) span.partial:not(.active) {
    opacity: 0.25;
  }
  .tip {
    position: absolute;
    top: 6px;
    z-index: 2;
    display: grid;
    gap: 3px;
    min-width: 150px;
    padding: 10px 12px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--raised);
    box-shadow: var(--shadow);
    font-size: 0.8rem;
    translate: 12px 0;
    pointer-events: none;
  }
  .tip.flip {
    translate: calc(-100% - 12px) 0;
  }
  .tip :global(span) {
    color: var(--muted);
  }
  .x {
    position: relative;
    grid-column: 2;
    height: 26px;
  }
  .x span {
    position: absolute;
    top: 8px;
    color: var(--faint);
    font-size: 0.75rem;
    white-space: nowrap;
    translate: -50% 0;
  }
  .x span:first-child {
    translate: 0 0;
    left: 0 !important;
  }
  .x span:last-child {
    translate: -100% 0;
    left: 100% !important;
  }
  .table {
    margin-top: 10px;
    font-size: 0.85rem;
  }
  summary {
    width: fit-content;
    color: var(--muted);
    cursor: pointer;
  }
  .scroll {
    max-height: 260px;
    overflow: auto;
    margin-top: 10px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  th,
  td {
    padding: 6px 12px;
    border-bottom: 1px solid var(--line);
    text-align: right;
  }
  th:first-child,
  td:first-child {
    text-align: left;
  }
  th {
    position: sticky;
    top: 0;
    background: var(--raised);
    font-weight: 600;
  }
</style>
