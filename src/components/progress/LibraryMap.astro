---
import { squarify } from "../../lib/treemap";
import type { ProgressGroup } from "../../lib/upstream";

interface Props {
  groups: ProgressGroup[];
}

const { groups } = Astro.props;
// Laid out in a 1000 × 560 box and placed in percentages, so the map scales with its container.
const W = 1000;
const H = 560;
const tiles = squarify([...groups].sort((a, b) => b.total - a.total), (g) => g.total, W, H);
const pct = (g: ProgressGroup) => Math.round((g.done / g.total) * 1000) / 10;
---

<div class="library-map" data-library-map data-pagefind-ignore>
  <div class="controls">
    <label class="search">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      <span class="visually-hidden">Find a library</span>
      <input type="search" placeholder={`Find one of ${tiles.length} libraries`} data-find />
    </label>
    <span class="key" aria-hidden="true"><i class="done"></i> Implemented <i class="todo"></i> Missing</span>
  </div>

  <div class="map" role="group" aria-label="Libraries sized by declared functions">
    {
      tiles.map((t) => {
        return (
          <button
            type="button"
            class:list={["tile", { complete: t.done === t.total }]}
            style={`left:${(t.x / W) * 100}%;top:${(t.y / H) * 100}%;width:${(t.w / W) * 100}%;height:${(t.h / H) * 100}%;--done:${pct(t)}%`}
            data-label={t.label}
            data-done={t.done}
            data-total={t.total}
            data-inert={t.inert}
            aria-label={`${t.label}: ${t.done} of ${t.total} functions, ${pct(t)}%`}
          >
            <span class="name">{t.label}</span>
          </button>
        );
      })
    }
    <div class="tip" hidden role="status"></div>
  </div>

  <section class="detail card" hidden aria-live="polite" data-detail>
    <header>
      <div>
        <h3 data-detail-name></h3>
        <p class="muted" data-detail-count></p>
      </div>
      <button type="button" class="button small" data-detail-close>Close</button>
    </header>
    <div class="cells" role="img" data-detail-cells></div>
    <p class="cells-key muted"><i class="done"></i> Implemented <i class="todo"></i> Missing · hover a cell for its name</p>
    <h4 class="names-head">Missing functions</h4>
    <ul class="names mono" data-detail-names></ul>
  </section>
</div>

<script>
  const number = new Intl.NumberFormat("en-GB");
  type Functions = Record<string, { done: string[]; todo: string[] }>;
  let functions: Promise<Functions> | undefined;
  const loadFunctions = () =>
    (functions ??= fetch("/progress/functions.json")
      .then((r): Promise<Functions> => (r.ok ? r.json() : Promise.resolve({})))
      .catch((): Functions => ({})));
  const missingOf = async (label: string) => (await loadFunctions())[label]?.todo ?? [];

  for (const root of document.querySelectorAll<HTMLElement>("[data-library-map]")) {
    const map = root.querySelector<HTMLElement>(".map")!;
    const tip = root.querySelector<HTMLElement>(".tip")!;
    const tiles = [...root.querySelectorAll<HTMLButtonElement>(".tile")];
    const detail = root.querySelector<HTMLElement>("[data-detail]")!;

    const summary = (tile: HTMLElement) => {
      const done = Number(tile.dataset.done);
      const total = Number(tile.dataset.total);
      const inert = Number(tile.dataset.inert);
      let text = `${number.format(done)} of ${number.format(total)} functions, ${total - done} missing`;
      if (inert) text += ` · ${inert} implemented as no-ops`;
      return text;
    };

    let hovered: HTMLElement | null = null;
    const showTip = async (tile: HTMLElement) => {
      hovered = tile;
      const box = map.getBoundingClientRect();
      const rect = tile.getBoundingClientRect();
      const name = document.createElement("b");
      name.textContent = tile.dataset.label!;
      const count = document.createElement("span");
      count.className = "muted";
      count.textContent = summary(tile);
      tip.replaceChildren(name, count);
      tip.hidden = false;
      const left = rect.left - box.left + rect.width / 2;
      tip.style.left = `${Math.min(Math.max(left, 150), box.width - 150)}px`;
      const below = rect.top - box.top < box.height / 2;
      tip.style.top = below ? `${rect.bottom - box.top + 8}px` : "";
      tip.style.bottom = below ? "" : `${box.bottom - rect.top + 8}px`;

      const names = await missingOf(tile.dataset.label!);
      if (hovered !== tile || !names.length) return;
      const list = document.createElement("ul");
      for (const n of names.slice(0, 8)) {
        const item = document.createElement("li");
        item.textContent = n;
        list.append(item);
      }
      tip.append(list);
      if (names.length > 8) {
        const more = document.createElement("span");
        more.className = "muted";
        more.textContent = `and ${names.length - 8} more · click to see all`;
        tip.append(more);
      }
    };

    const openDetail = async (tile: HTMLElement) => {
      tiles.forEach((t) => t.classList.toggle("selected", t === tile));
      root.querySelector("[data-detail-name]")!.textContent = tile.dataset.label!;
      root.querySelector("[data-detail-count]")!.textContent = summary(tile);
      const list = root.querySelector<HTMLElement>("[data-detail-names]")!;
      const { done = [], todo: names = [] } = (await loadFunctions())[tile.dataset.label!] ?? {};
      // One cell per declared function, implemented first, so the library reads like a filling bar.
      const cells = root.querySelector<HTMLElement>("[data-detail-cells]")!;
      cells.setAttribute("aria-label", summary(tile));
      cells.replaceChildren(
        ...[...done.map((n) => [n, true] as const), ...names.map((n) => [n, false] as const)].map(([n, ok]) => {
          const cell = document.createElement("i");
          cell.title = n;
          if (ok) cell.className = "done";
          return cell;
        }),
      );
      list.replaceChildren(
        ...(names.length ? names : ["Every declared function is implemented."]).map((n) => {
          const item = document.createElement("li");
          item.textContent = n;
          return item;
        }),
      );
      detail.hidden = false;
      detail.scrollIntoView({ block: "nearest", behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
    };

    for (const tile of tiles) {
      tile.addEventListener("pointerenter", () => showTip(tile));
      tile.addEventListener("focus", () => showTip(tile));
      tile.addEventListener("blur", () => (tip.hidden = true));
      tile.addEventListener("click", () => openDetail(tile));
    }
    map.addEventListener("pointerleave", () => ((tip.hidden = true), (hovered = null)));
    root.querySelector("[data-detail-close]")!.addEventListener("click", () => {
      detail.hidden = true;
      tiles.forEach((t) => t.classList.remove("selected"));
    });

    const find = root.querySelector<HTMLInputElement>("[data-find]")!;
    const search = (query: string) => {
      const q = query.trim().toLowerCase();
      map.classList.toggle("searching", q.length > 0);
      for (const t of tiles) t.classList.toggle("match", q.length > 0 && t.dataset.label!.toLowerCase().includes(q));
    };
    find.addEventListener("input", () => search(find.value));

    // Game pages link here with ?library=Label to show what that library is missing.
    const linked = new URLSearchParams(location.search).get("library");
    const target = linked && tiles.find((t) => t.dataset.label === linked);
    if (target) {
      find.value = linked;
      search(linked);
      openDetail(target);
    }
  }
</script>

<style>
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 20px;
    margin-bottom: 14px;
  }
  .search {
    display: flex;
    flex: 0 1 320px;
    align-items: center;
    gap: 10px;
    height: 40px;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--faint);
  }
  .search:focus-within {
    border-color: var(--accent);
  }
  .search input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: none;
    color: var(--text);
    font: inherit;
    font-size: 0.9rem;
  }
  .key {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-size: 0.82rem;
  }
  .key i {
    width: 12px;
    height: 12px;
    border-radius: 3px;
  }
  .key i.done {
    background: var(--good);
  }
  .key i.todo {
    margin-left: 10px;
    background: var(--stage-untested);
  }

  .map {
    position: relative;
    aspect-ratio: 1000 / 560;
    overflow: visible;
    container-type: inline-size;
  }
  .tile {
    position: absolute;
    overflow: hidden;
    margin: 0;
    padding: 0;
    border: 0;
    /* A 2px surface gap between tiles. */
    box-shadow: inset 0 0 0 1px var(--bg);
    border-radius: 4px;
    /* Implemented functions fill the tile from the bottom; a fine grid hints at individual functions. */
    background: linear-gradient(to top, color-mix(in srgb, var(--good) 78%, var(--surface)) var(--done), var(--stage-untested) var(--done));
    color: var(--text);
    font: inherit;
    text-align: left;
    cursor: pointer;
    container-type: size;
    transition: filter 0.15s, opacity 0.15s;
  }
  .tile::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, color-mix(in srgb, var(--bg) 35%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, var(--bg) 35%, transparent) 1px, transparent 1px);
    background-size: 7px 7px;
    pointer-events: none;
  }
  .tile.complete {
    background: var(--good);
  }
  .tile:hover,
  .tile:focus-visible,
  .tile.selected {
    z-index: 1;
    filter: brightness(1.15);
    outline: 2px solid var(--text);
    outline-offset: -1px;
  }
  .name {
    position: absolute;
    top: 5px;
    left: 5px;
    z-index: 1;
    max-width: calc(100% - 10px);
    overflow: hidden;
    padding: 1px 6px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    font-size: clamp(0.62rem, 1.15cqi, 0.78rem);
    font-weight: 600;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  /* Labels only where they fit; every tile still names itself in its tooltip and accessible label. */
  @container (width < 56px) or (height < 24px) {
    .name {
      display: none;
    }
  }
  .searching .tile:not(.match) {
    opacity: 0.25;
  }
  .searching .tile.match .name {
    display: block;
  }

  .tip {
    position: absolute;
    z-index: 3;
    display: grid;
    gap: 4px;
    width: max-content;
    max-width: 300px;
    padding: 12px 14px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--raised);
    box-shadow: 0 16px 40px -12px rgb(0 0 0 / 0.5);
    font-size: 0.82rem;
    translate: -50% 0;
    pointer-events: none;
  }
  .tip :global(ul) {
    display: grid;
    gap: 1px;
    margin: 6px 0 0;
    padding: 0;
    list-style: none;
    font: 0.74rem/1.45 var(--mono);
  }
  .tip :global(li) {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .detail {
    margin-top: 16px;
    padding: 20px 22px;
  }
  .detail header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }
  .detail h3 {
    margin: 0;
  }
  .detail p {
    margin: 4px 0 14px;
    font-size: 0.88rem;
  }
  .cells {
    display: grid;
    grid-template-columns: repeat(auto-fill, 11px);
    gap: 2px;
    max-height: 260px;
    overflow: auto;
    margin-bottom: 8px;
  }
  .cells :global(i) {
    width: 11px;
    height: 11px;
    border-radius: 2px;
    background: var(--stage-untested);
  }
  .cells :global(i.done) {
    background: var(--good);
  }
  .cells :global(i:hover) {
    outline: 2px solid var(--text);
  }
  .cells-key {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0 0 18px;
    font-size: 0.78rem;
  }
  .cells-key i {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: var(--stage-untested);
  }
  .cells-key i.done {
    background: var(--good);
  }
  .cells-key i.todo {
    margin-left: 8px;
  }
  .names-head {
    margin: 0 0 8px;
    color: var(--faint);
    font: 500 0.7rem var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .names {
    columns: 3 220px;
    column-gap: 24px;
    max-height: 320px;
    overflow: auto;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.78rem;
    line-height: 1.6;
  }
  .names li {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  @media (max-width: 700px) {
    .map {
      aspect-ratio: 1000 / 900;
    }
  }
</style>
