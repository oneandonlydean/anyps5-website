---
interface Props {
  size?: number;
}
const { size = 20 } = Astro.props;
---

<span class="mark" style={`--size:${size}px`} aria-hidden="true"><i></i><i></i><i></i><i></i></span>

<style>
  .mark {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--size) * 0.16);
  }
  i {
    width: calc(var(--size) * 0.2);
    height: var(--size);
    border-radius: calc(var(--size) * 0.06);
    background: currentColor;
  }
  i:nth-child(2) {
    background: linear-gradient(#84b4ff, var(--accent));
  }
  i:nth-child(3) {
    background: linear-gradient(#6ff0dc, var(--accent-2));
  }
  i:last-child {
    opacity: 0.3;
  }
</style>
