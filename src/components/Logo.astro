---
// The mark is traced from src/assets/logo/source.png and filled with currentColor,
// so it follows the text colour: white on the dark theme, near-black on the light one.
import mark from "../assets/logo/mark.svg?raw";

interface Props {
  size?: number;
}
const { size = 20 } = Astro.props;
---

<span class="mark" style={`--size:${size}px`} aria-hidden="true" set:html={mark} />

<style>
  .mark {
    display: inline-flex;
    align-items: center;
    color: var(--text);
  }
  .mark :global(svg) {
    height: var(--size);
    width: auto;
  }
</style>
