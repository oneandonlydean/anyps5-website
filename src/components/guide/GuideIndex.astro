---
import Article from "../../layouts/Article.astro";
import StepList from "./StepList.astro";
import { localizeLinks, strings, type Locale } from "../../i18n";
import { getSteps, guideNav } from "../../lib/guide";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = strings(locale).guide;
const steps = await getSteps(locale);
---

<Article title={t.title} eyebrow={t.eyebrow} lede={t.lede} nav={guideNav(steps, locale)}>
  <StepList steps={steps} locale={locale} />
  <p class="muted" set:html={localizeLinks(t.already, locale)} />
</Article>
