---
import Base from "../../layouts/Base.astro";
import GameArt from "../GameArt.astro";
import StageBadge from "../StageBadge.astro";
import StageBar from "../StageBar.astro";
import Latest from "./Latest.astro";
import { getGames } from "../../lib/data";
import { DISCORD_ICON, DISCORD_URL, GITHUB_ICON, REPO_URL } from "../../lib/site";
import { STAGES, stageRank, stageSlug } from "../../lib/stages";
import { getCoverage, getProgress, getRelease } from "../../lib/upstream";
import { loadGenerated } from "../../lib/load";
import { softwareSchema, websiteSchema } from "../../lib/structured-data";
import { artSrc, reach } from "../../lib/view";
import { LOCALES, localePath, strings, type Locale } from "../../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = strings(locale);
const local = (path: string) => localePath(locale, path);
const num = (n: number) => n.toLocaleString(locale === "en" ? "en-GB" : locale);

const [games, release, progress, coverage] = await Promise.all([getGames(), getRelease(), getProgress(), getCoverage()]);
const shaders = coverage && { percent: (coverage.instructions.decoded / coverage.instructions.total) * 100 };
const byReach = [...games].sort((a, b) => stageRank(reach(b).stage) - stageRank(reach(a).stage) || b.updated.localeCompare(a.updated));
// Ten columns, so the wall reaches across even a wide screen.
const WALL_COLUMNS = 10;
const wall = byReach.filter((g) => g.art?.cover).slice(0, WALL_COLUMNS * 6);
const columns = Array.from({ length: WALL_COLUMNS }, (_, c) => wall.filter((_, i) => i % WALL_COLUMNS === c));
const featured = byReach.filter((g) => g.art?.hero).slice(0, 6);
const tested = games.filter((g) => reach(g).stage);
const ingame = games.filter((g) => stageRank(reach(g).stage) >= stageRank("Ingame")).length;
const playable = games.filter((g) => g.stage === "Playable").length;
const START_ICONS = {
  playable: "M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0zM12 9v4M12 17h.01",
  own: "M6 12h4M8 10v4M15 13h.01M18 11h.01M17.3 5H6.7a4 4 0 0 0-3.9 3.6L2 15a3 3 0 0 0 5.4 2L9 15h6l1.6 2a3 3 0 0 0 5.4-2l-.8-6.4A4 4 0 0 0 17.3 5z",
  easy: "M3 5h18v14H3zM3 9h18M7 7h.01M10 7h.01M12 12v4M10 14l2 2 2-2",
  help: "M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z",
};
const startPoints = [
  { icon: START_ICONS.playable, title: t.home.start.playableTitle, text: t.home.start.playableText(num(playable), num(games.length)), warn: true },
  { icon: START_ICONS.own, title: t.home.start.ownTitle, text: t.home.start.ownText },
  { icon: START_ICONS.easy, title: t.home.start.easyTitle, text: t.home.start.easyText },
  { icon: START_ICONS.help, title: t.home.start.helpTitle, text: t.home.start.helpText },
];
const distribution = STAGES.map((s, i) => ({ ...s, count: tested.filter((g) => stageRank(reach(g).stage) === i).length })).filter((s) => s.count > 0);
// The people behind the project: code contributors by commits, and everyone who has filed a test report.
const {
  total: contributorTotal,
  commits: commitTotal,
  people: contributors,
} = await loadGenerated<{
  total: number;
  /** Commits on the default branch; data from before it was recorded falls back to the per-person sum. */
  commits?: number;
  people: { login: string; avatar: string; url: string; contributions: number }[];
}>("contributors.json", { total: 0, people: [] });
const leaders = contributors.slice(0, 6);
// Two rows of 90 keep the page light; everyone else is a link away.
const LANE = 90;
const crowd = contributors.slice(6, 6 + LANE * 2);
const crowdRows = [crowd.filter((_, i) => i % 2 === 0), crowd.filter((_, i) => i % 2 === 1)];
const unseen = contributorTotal - leaders.length - crowd.length;
const commits = commitTotal ?? contributors.reduce((n, c) => n + c.contributions, 0);
const testerCounts = new Map<string, number>();
for (const g of games) for (const r of g.reports) if (r.author) testerCounts.set(r.author, (testerCounts.get(r.author) ?? 0) + 1);
const testers = [...testerCounts].sort((a, b) => b[1] - a[1]).map(([login, reports]) => ({ login, reports }));
// Like the contributors: the six with the most reports get a card, everyone else is in the moving row.
const topTesters = testers.slice(0, 6);
const laneTesters = testers.slice(6);
const avatar = (url: string, size: number) => `${url}${url.includes("?") ? "&" : "?"}s=${size * 2}`;
const testerAvatar = (login: string, size: number) => `https://github.com/${encodeURIComponent(login)}.png?size=${size * 2}`;

// The areas a game leans on first, in the order a frame needs them. Each bar counts every library in its area, so
// "Graphics" means the whole path to the screen, not only its best-covered library.
const LIBRARY_AREAS = {
  libkernel: ["libkernel", "libkernel_sys"],
  libc: ["libc", "LibcInternal"],
  Agc: ["Agc", "AgcDriver", "GnmDriverForNeoMode", "VideoOut"],
  AudioOut: ["AudioOut", "Audio3d", "Audiodec", "AudiodecCpu"],
  Pad: ["Pad", "PadTracker"],
} as const;
const libraries = (Object.keys(LIBRARY_AREAS) as (keyof typeof LIBRARY_AREAS)[]).flatMap((key) => {
  const groups = (progress?.libraries.groups ?? []).filter((g) => (LIBRARY_AREAS[key] as readonly string[]).includes(g.label));
  const done = groups.reduce((n, g) => n + g.done, 0);
  const total = groups.reduce((n, g) => n + g.total, 0);
  if (!total) return [];
  const detail = groups.map((g) => `${g.label} ${g.done}/${g.total}`).join(", ");
  return [{ ...t.home.libraryNames[key], percent: (done / total) * 100, detail }];
});

const STEP_LINKS = [
  { href: local("/docs/guide/dump"), icon: "M6 4h12a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm2 17h8M12 17v4" },
  { href: "/convert", icon: "M4 7h11m0 0-3-3m3 3-3 3M20 17H9m0 0 3-3m-3 3 3 3" },
  { href: local("/docs/guide/run"), icon: "M8 5.5v13l11-6.5-11-6.5Z" },
];
const steps = t.home.steps.map((step, i) => ({ ...step, ...STEP_LINKS[i] }));
---

<Base description={t.meta.description} schema={[websiteSchema(Astro.site!, LOCALES[locale].lang, t.meta.description), softwareSchema(Astro.site!, release)]}>
  <section class="hero" data-hero>
    <div class="wall" aria-hidden="true">
      {
        columns.map((column, c) => (
          <div class="column" style={`--speed:${60 + c * 9}s;--phase:${c % 2 ? 0.5 : 0}`}>
            {[...column, ...column].map((g, i) => (
              <GameArt name={g.name} src={g.art!.cover} color={g.art!.color} ratio="2/3" widths={[240, 360]} sizes="180px" eager={i < 3 && c >= 5} loading="eager" />
            ))}
          </div>
        ))
      }
    </div>
    <div class="container hero-copy">
      <h1 set:html={t.home.headline.replace("<em>", '<span class="gradient-text">').replace("</em>", "</span>")} />
      <p class="lede">{t.home.lede}</p>
      <div class="ctas">
        <a class="button primary" href="/download">{t.nav.download}{release && <span class="version">{release.tag}</span>}</a>
        <a class="button ghost" href={local("/docs/guide")}>{t.home.setupGuide}</a>
        <a class="button ghost" href="/convert">{t.nav.converter}</a>
      </div>
      <ul class="facts" aria-label={t.home.atAGlance}>
        {/* The first fact is the project's stage: it points to the section that explains it. */}
        {t.home.facts.map((fact, i) => (i === 0 ? <li class="early">{fact}</li> : <li>{fact}</li>))}
      </ul>
    </div>
  </section>

  <section class="container status" aria-label={t.home.status}>
    {
      progress && (
        <a class="stat card" href="/progress">
          <span class="label">{t.home.libraries}</span>
          <b>
            <span data-count={progress.libraries.percent.toFixed(2)} data-digits="2">{progress.libraries.percent.toFixed(2)}</span>
            <small>%</small>
          </b>
          <span class="meter" style={`--value:${progress.libraries.percent}%`} />
          <span class="muted">{t.home.librariesOf(num(progress.libraries.done), num(progress.libraries.total))}</span>
        </a>
      )
    }
    {
      shaders && (
        <a class="stat card" href="/progress#shaders">
          <span class="label">{t.home.shaders}</span>
          <b>
            <span data-count={shaders.percent.toFixed(2)} data-digits="2">{shaders.percent.toFixed(2)}</span>
            <small>%</small>
          </b>
          <span class="meter" style={`--value:${shaders.percent}%`} />
          <span class="muted">{t.home.shadersOf}</span>
        </a>
      )
    }
    <a class="stat card" href="/compatibility">
      <span class="label">{t.home.gamesUnderTest}</span>
      <b data-count={games.length}>{games.length}</b>
      <span class="stack" role="img" aria-label={distribution.map((s) => `${s.count} ${t.stage.names[s.name]}`).join(", ")}>
        {distribution.map((s) => <i style={`flex:${s.count};background:var(--stage-${stageSlug(s.name)})`} />)}
      </span>
      <span class="muted">{t.home.withReports(num(tested.length))}</span>
    </a>
    <a class="stat card" href="/compatibility?stage=6,7">
      <span class="label">{t.home.reachGameplay}</span>
      <b data-count={ingame}>{ingame}</b>
      <span class="meter play" style={`--value:${(ingame / Math.max(tested.length, 1)) * 100}%`} />
      <span class="muted">{t.home.ofTested(String(Math.round((ingame / Math.max(tested.length, 1)) * 100)))}</span>
    </a>
  </section>

  <section class="container start" id="start" aria-labelledby="start-title">
    <div class="start-card card reveal">
      <div class="start-intro">
        <h2 id="start-title">{t.home.start.title}</h2>
        <p class="muted">{t.home.start.text}</p>
        <div class="start-ctas">
          <a class="button primary" href="/compatibility">{t.home.start.checkGame}</a>
          <a class="button ghost" href="/convert">{t.home.openConverter}</a>
        </div>
      </div>
      <ul class="start-points">
        {
          startPoints.map((p) => (
            <li class:list={{ warn: p.warn }}>
              <span class="icon small" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d={p.icon} />
                </svg>
              </span>
              <div>
                <h3>{p.title}</h3>
                <p class="muted">{p.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Latest locale={locale} />

  <section class="container section">
    <div class="section-head reveal">
      <h2>{t.home.stepsTitle}</h2>
    </div>
    <ol class="steps">
      {
        steps.map((s) => (
          <li class="step card reveal">
            <span class="icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d={s.icon} />
              </svg>
            </span>
            <h3>{s.title}</h3>
            <p class="muted">{s.text}</p>
            <a href={s.href}>
              {t.home.learnMore} <span aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="container section native">
    <div class="native-copy reveal">
      <h2>{t.home.nativeTitle}</h2>
      <p class="muted">{t.home.nativeText}</p>
      <a class="button" href="/progress">{t.home.libraryProgress}</a>
    </div>
    <div class="diagram card reveal" aria-label={t.home.diagram}>
      <div class="node">
        <span class="file mono">eboot.bin</span>
        <span class="muted">{t.home.fromDump}</span>
      </div>
      <div class="link" aria-hidden="true"><span>{t.home.relink}</span></div>
      <div class="node accent">
        <span class="file mono">app.elf · app.exe</span>
        <span class="muted">{t.home.nativeProgram}</span>
      </div>
      <div class="link" aria-hidden="true"><span>{t.home.calls}</span></div>
      <ul class="libs">
        {
          libraries.map((l) => (
            <li>
              <span>
                <b>{l.name}</b>
                <span class="muted">{l.role}</span>
              </span>
              <span class="lib-meter" style={`--value:${l.percent}%`} title={l.detail}>
                <span class="mono">{l.percent.toFixed(0)}%</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="container section">
        <div class="section-head row reveal">
          <div>
            <h2>{t.home.furthestTitle}</h2>
          </div>
          <a class="button" href="/compatibility">
            {t.home.allGames}
          </a>
        </div>
        <div class="featured">
          {featured.map((g, i) => {
            const r = reach(g);
            return (
              <a class:list={["feature reveal", { wide: i < 2 }]} href={`/compatibility/${g.slug}`} style={`--tint:${g.art?.color ?? "#223"}`}>
                {/* The art and its scrim morph together into the game page's backdrop. */}
                <div class="feature-media" data-vt={`hero-${g.slug}`}>
                  <img class="feature-art" src={artSrc(g.art!.hero!, i < 2 ? 1280 : 800)} alt="" loading="lazy" decoding="async" />
                </div>
                <div class="feature-copy">
                  {g.art?.logo ? <img class="feature-logo" src={artSrc(g.art.logo, 480)} alt={g.name} loading="lazy" /> : <h3>{g.name}</h3>}
                  <div class="feature-stage">
                    <StageBadge stage={r.stage} onMain={r.onMain} locale={locale} />
                    <StageBar stage={g.stage} branchStage={g.branchStage} locale={locale} />
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )
  }

  <section class="container section people" aria-labelledby="people-title">
    <div class="people-head reveal">
      <div>
        <h2 id="people-title">{t.home.peopleTitle}</h2>
        <p class="muted">{t.home.peopleText}</p>
      </div>
      <dl class="people-stats">
        <div><dt>{t.home.contributors}</dt><dd data-count={contributorTotal}>{num(contributorTotal)}</dd></div>
        <div><dt>{t.home.commits}</dt><dd data-count={commits}>{num(commits)}</dd></div>
        <div><dt>{t.home.testers}</dt><dd data-count={testers.length}>{num(testers.length)}</dd></div>
      </dl>
    </div>

    {
      leaders.length > 0 && (
        <>
        <h3 class="leaders-title reveal">{t.home.topContributors}</h3>
        <ol class="leaders reveal">
          {leaders.map((c) => (
            <li>
              <a href={c.url}>
                <img src={avatar(c.avatar, 56)} alt="" width="56" height="56" loading="lazy" decoding="async" />
                <span class="who">
                  <b>{c.login}</b>
                  <span class="muted">{t.home.commitCount(c.contributions, num(c.contributions))}</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
        </>
      )
    }

    <div class="crowd reveal">
      {
        crowdRows.map((row, r) =>
          row.length ? (
            <div class="lane" aria-label={r === 0 ? t.home.moreContributors : undefined}>
              <div class="window">
                <div class:list={["track", { reverse: r === 1 }]} style={`--duration:${Math.max(row.length * 1.4, 40)}s`}>
                  {[0, 1].map((copy) => (
                    <ul aria-hidden={copy === 1 ? "true" : undefined}>
                      {row.map((c) => (
                        <li>
                          <a href={c.url} data-name={`${c.login} · ${t.home.commitCount(c.contributions, num(c.contributions))}`} tabindex={copy === 1 ? -1 : undefined}>
                            <img src={avatar(c.avatar, 40)} alt={copy === 1 ? "" : c.login} width="40" height="40" loading="lazy" decoding="async" />
                          </a>
                        </li>
                      ))}
                      {r === 1 && unseen > 0 && (
                        <li>
                          <a class="more" href={`${REPO_URL}/graphs/contributors`} data-name={t.home.everyone} tabindex={copy === 1 ? -1 : undefined}>
                            +{num(unseen)}
                          </a>
                        </li>
                      )}
                    </ul>
                  ))}
                </div>
              </div>
            </div>
          ) : null,
        )
      }
    </div>

    {
      topTesters.length > 0 && (
        <>
          <h3 class="leaders-title reveal">{t.home.topTesters}</h3>
          <ol class="leaders tester-leaders reveal">
            {topTesters.map((tester) => (
              <li>
                <a href={`https://github.com/${encodeURIComponent(tester.login)}`}>
                  <img src={testerAvatar(tester.login, 56)} alt="" width="56" height="56" loading="lazy" decoding="async" />
                  <span class="who">
                    <b>{tester.login}</b>
                    <span class="muted">{t.home.reportCount(tester.reports, num(tester.reports))}</span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </>
      )
    }

    <div class="crowd reveal">
      {
        laneTesters.length > 0 && (
          <div class="lane testers" aria-label={t.home.testers}>
            <div class="window">
              <div class="track" style={`--duration:${Math.max(laneTesters.length * 1.6, 40)}s`}>
                {[0, 1].map((copy) => (
                  <ul aria-hidden={copy === 1 ? "true" : undefined}>
                    {laneTesters.map((tester) => (
                      <li>
                        <a href={`https://github.com/${encodeURIComponent(tester.login)}`} data-name={`${tester.login} · ${t.home.reportCount(tester.reports, num(tester.reports))}`} tabindex={copy === 1 ? -1 : undefined}>
                          <img src={testerAvatar(tester.login, 40)} alt={copy === 1 ? "" : tester.login} width="40" height="40" loading="lazy" decoding="async" />
                        </a>
                      </li>
                    ))}
                  </ul>
                ))}
              </div>
            </div>
          </div>
        )
      }
    </div>

    <div class="join card reveal">
      <div>
        <h3>{t.home.joinTitle}</h3>
        <p class="muted">{t.home.joinText}</p>
      </div>
      <div class="links">
        <a class="button primary discord" href={DISCORD_URL}><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d={DISCORD_ICON} /></svg>{t.home.discord}</a>
        <a class="button ghost" href={REPO_URL}><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d={GITHUB_ICON} /></svg>{t.home.github}</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // The cover wall and the avatar rows stop moving while they're scrolled out of view, so they cost nothing there.
  const offscreen = new IntersectionObserver((entries) => {
    for (const entry of entries) (entry.target as HTMLElement).toggleAttribute("data-offscreen", !entry.isIntersecting);
  });
  document.querySelectorAll("[data-hero], .lane").forEach((el) => offscreen.observe(el));
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: min(90vh, 880px);
    overflow: hidden;
    isolation: isolate;
    margin-top: -1px;
  }
  .wall {
    position: absolute;
    inset: -10% -6%;
    z-index: -3;
    display: grid;
    grid-template-columns: repeat(10, minmax(150px, 1fr));
    gap: 14px;
    /* Kept cheap to draw, as it moves for as long as the page is open: upright columns (a tilted wall made every frame
       resample the rotated covers, the page's biggest cost), no mask, and each column on its own layer, so a frame only
       shifts the columns instead of redrawing the whole wall. That matters most without GPU acceleration, where every
       redraw is CPU work. The fades are drawn over it by .hero::before. */
    opacity: 0.9;
  }
  .column {
    display: grid;
    gap: 14px;
    align-content: start;
    /* Each column holds its covers twice and drifts up by one set, so it loops without a seam. Odd columns start half a
       loop in: a negative delay staggers them, where shifting them would run them out of covers before the loop ends. */
    animation: drift var(--speed) linear infinite;
    animation-delay: calc(var(--speed) * var(--phase) * -1);
    will-change: transform;
  }
  .hero[data-offscreen] .column {
    animation-play-state: paused;
  }
  .column :global(.art) {
    border-radius: 12px;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.06);
  }
  @keyframes drift {
    to {
      transform: translateY(-50%);
    }
  }
  /* The fades over the wall. Static, so on a layer of its own it is drawn once and only composited as the wall moves. */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    will-change: transform;
    background:
      var(--grain),
      /* Top and bottom: eased into the page's colour, and solid before the edge, so the wall never ends on a line. */
      linear-gradient(
        to bottom,
        var(--bg),
        transparent 14%,
        transparent 64%,
        color-mix(in srgb, var(--bg) 55%, transparent) 78%,
        color-mix(in srgb, var(--bg) 88%, transparent) 88%,
        var(--bg) 95%
      ),
      linear-gradient(to left, var(--bg), transparent 12%),
      /* The wall shows dimmed across the whole width, and darkest behind the text, which starts where the page's
         content column does. */
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--bg) 70%, transparent) 0,
        color-mix(in srgb, var(--bg) 92%, transparent) max(0px, (100% - var(--width)) / 2),
        color-mix(in srgb, var(--bg) 85%, transparent) calc(max(0px, (100% - var(--width)) / 2) + 560px),
        transparent calc(max(0px, (100% - var(--width)) / 2) + 900px)
      );
  }
  .hero-copy {
    padding-block: 72px;
  }
  .hero-copy > * {
    max-width: 640px;
  }
  /* The latest release's tag, carried in the Download button. */
  .version {
    font: 600 0.74rem var(--mono);
  }
  .hero h1 {
    font-size: clamp(2.8rem, 7vw, 5.6rem);
    line-height: 0.96;
    letter-spacing: -0.03em;
    /* Position only: an element at opacity 0 cannot be the page's largest paint, which delays it. */
    animation: rise-in-place 0.9s var(--ease) both;
  }
  @keyframes rise-in-place {
    from {
      transform: translateY(16px);
    }
  }
  .hero .lede {
    animation: rise 0.9s 0.08s var(--ease) both;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 32px;
    animation: rise 0.9s 0.16s var(--ease) both;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
