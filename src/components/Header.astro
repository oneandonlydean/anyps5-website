---
import Logo from "./Logo.astro";
import Search from "./Search.astro";
import { DEFAULT_LOCALE, isTranslated, LOCALES, localePath, parsePath, strings, type Locale } from "../i18n";
import { DISCORD_ICON, DISCORD_URL, GITHUB_ICON, NAV, REPO_URL } from "../lib/site";

const { locale, path } = parsePath(Astro.url.pathname);
const t = strings(locale);
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
const nav = NAV.map(({ href, key, translated }) => ({
  href: localePath(locale, locale !== DEFAULT_LOCALE && translated ? translated : href),
  label: t.nav[key],
  current: isCurrent(href),
}));
// Each language's version of this page, or that language's home page when this page is English only.
const languages = (Object.keys(LOCALES) as Locale[]).map((l) => ({ locale: l, name: LOCALES[l].name, href: localePath(l, isTranslated(path) ? path : "/") }));
---

<header class="header">
  <div class="container bar">
    <a class="brand" href={localePath(locale, "/")} aria-label={t.nav.home}><Logo size={18} /> AnyPS5</a>

    <nav class="nav" aria-label="Main">
      {nav.map(({ href, label, current }) => <a href={href} aria-current={current ? "page" : undefined}>{label}</a>)}
    </nav>

    <div class="tools">
      <button class="icon" type="button" aria-label={t.nav.search} data-search-open>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      </button>
      <details class="lang">
        <summary class="icon" aria-label={t.nav.language}>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 8 6 6M4 14l6-6 2-3M2 5h12M7 2h1M22 22l-5-10-5 10M14 18h6"/></svg>
        </summary>
        <ul class="lang-menu">
          {languages.map((l) => (
            <li>
              <a href={l.href} hreflang={LOCALES[l.locale].lang} lang={LOCALES[l.locale].lang} aria-current={l.locale === locale ? "true" : undefined}>
                {l.name}
              </a>
            </li>
          ))}
        </ul>
      </details>
      <a class="icon" href={DISCORD_URL} aria-label="Discord">
        <svg viewBox="0 0 24 24" width="19" height="19" fill="currentColor"><path d={DISCORD_ICON} /></svg>
      </a>
      <a class="icon" href={REPO_URL} aria-label="GitHub repository">
        <svg viewBox="0 0 24 24" width="19" height="19" fill="currentColor"><path d={GITHUB_ICON} /></svg>
      </a>
      <button class="icon theme" type="button" aria-label={t.nav.theme} data-theme-toggle>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <button class="icon menu" type="button" aria-label={t.nav.menu} aria-expanded="false" aria-controls="mobile-nav" data-menu-toggle>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>

  <Search />

  <nav id="mobile-nav" class="mobile" aria-label="Main" hidden>
    {nav.map(({ href, label, current }) => <a href={href} aria-current={current ? "page" : undefined}>{label}</a>)}
  </nav>
</header>

<script>
  // The whole page changes theme in one cross-fade, as long as a page change takes, instead of each element fading its
  // own colours at its own speed. Element transitions are off for the switch, so nothing lags behind the fade.
  document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
    const root = document.documentElement;
    const next = root.dataset.theme === "light" ? "dark" : "light";
    const apply = () => {
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {}
      document.dispatchEvent(new CustomEvent("themechange", { detail: next }));
    };
    root.dataset.themeSwitching = "";
    const done = () => requestAnimationFrame(() => delete root.dataset.themeSwitching);
    if (document.startViewTransition && !matchMedia("(prefers-reduced-motion: reduce)").matches) document.startViewTransition(apply).finished.then(done, done);
    else {
      apply();
      done();
    }
  });

  const languages = document.querySelector<HTMLDetailsElement>(".lang");
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const mobile = document.getElementById("mobile-nav");
  const setMenu = (open: boolean) => {
    toggle?.setAttribute("aria-expanded", String(open));
    if (mobile) mobile.hidden = !open;
  };
  toggle?.addEventListener("click", () => setMenu(toggle.getAttribute("aria-expanded") !== "true"));
  // A click anywhere else closes the language menu and the phone menu.
  document.addEventListener("click", (event) => {
    const target = event.target as Node;
    if (languages?.open && !languages.contains(target)) languages.open = false;
    if (mobile && !mobile.hidden && !mobile.contains(target) && !toggle?.contains(target)) setMenu(false);
  });
  // Escape closes the menu, and so does widening the window to where the full navigation shows.
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && mobile && !mobile.hidden) {
      setMenu(false);
      toggle?.focus();
    }
  });
  matchMedia("(min-width: 881px)").addEventListener("change", (event) => event.matches && setMenu(false));
</script>

<style>
  /* No view-transition-name: a captured header loses its backdrop blur, so it would flicker as each transition ended.
     As part of the page's crossfade it stays steady, since its pixels are the same on both pages. */
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    text-decoration: none;
    font-family: var(--display);
    font-optical-sizing: auto;
  }
  .nav {
    display: flex;
    gap: 4px;
  }
  .nav a,
  .mobile a {
    padding: 8px 12px;
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.15s, background 0.15s;
  }
  .nav a:hover,
  .nav a[aria-current] {
    color: var(--text);
    background: var(--raised);
  }
  .tools {
    display: flex;
    gap: 2px;
    margin-left: auto;
  }
  .icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--muted);
    cursor: pointer;
  }
  .icon:hover {
    color: var(--text);
    background: var(--raised);
  }
  .menu {
    display: none;
  }
  .lang {
    position: relative;
  }
  .lang summary {
    list-style: none;
  }
  .lang summary::-webkit-details-marker {
    display: none;
  }
  .lang-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    z-index: 60;
    display: grid;
    min-width: 190px;
    margin: 0;
    padding: 6px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--raised);
    box-shadow: 0 20px 40px -16px rgb(0 0 0 / 0.5);
    list-style: none;
  }
  /* On a phone the globe sits near the left edge, so the menu opens rightwards to stay on screen. */
  @media (max-width: 640px) {
    .lang-menu {
      right: auto;
      left: 0;
    }
  }
  .lang-menu a {
    display: block;
    padding: 8px 12px;
    border-radius: 6px;
    color: var(--text);
    font-size: 0.9rem;
    text-decoration: none;
  }
  .lang-menu a:hover {
    background: var(--surface);
  }
  .lang-menu a[aria-current] {
    color: var(--accent);
    font-weight: 600;
  }
  .mobile {
    display: grid;
    gap: 2px;
    padding: 8px var(--gutter) 16px;
    border-top: 1px solid var(--line);
  }
  .mobile a {
    padding: 12px;
    border-radius: var(--radius-sm);
    font-size: 1rem;
  }
  .mobile a[aria-current] {
    color: var(--text);
    background: var(--raised);
  }
  @media (max-width: 880px) {
    .nav {
      display: none;
    }
    .menu {
      display: grid;
    }
  }
  /* A narrow phone: tighter icons, so the six of them and the name fit without widening the page. */
  @media (max-width: 420px) {
    .bar {
      gap: 12px;
    }
    .icon {
      width: 34px;
    }
  }
</style>
