---
import Logo from "./Logo.astro";
import Search from "./Search.astro";
import { DEFAULT_LOCALE, isTranslated, LOCALES, localePath, parsePath, strings, type Locale } from "../i18n";
import { DISCORD_URL, NAV, REPO_URL } from "../lib/site";

const { locale, path } = parsePath(Astro.url.pathname);
const t = strings(locale);
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
const nav = NAV.map(({ href, key, translated }) => ({
  href: localePath(locale, locale !== DEFAULT_LOCALE && translated ? translated : href),
  label: t.nav[key],
  current: isCurrent(href),
}));
// Each language's version of this page, or that language's home page when this page is English only.
const languages = (Object.keys(LOCALES) as Locale[]).map((l) => ({ locale: l, name: LOCALES[l].name, href: localePath(l, isTranslated(path) ? path : "/") }));
---

<header class="header">
  <div class="container bar">
    <a class="brand" href={localePath(locale, "/")} aria-label={t.nav.home}><Logo size={18} /> AnyPS5</a>

    <nav class="nav" aria-label="Main">
      {nav.map(({ href, label, current }) => <a href={href} aria-current={current ? "page" : undefined}>{label}</a>)}
    </nav>

    <div class="tools">
      <details class="lang">
        <summary class="icon" aria-label={t.nav.language}>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3Z"/></svg>
        </summary>
        <ul class="lang-menu">
          {languages.map((l) => (
            <li>
              <a href={l.href} hreflang={LOCALES[l.locale].lang} lang={LOCALES[l.locale].lang} aria-current={l.locale === locale ? "true" : undefined}>
                {l.name}
              </a>
            </li>
          ))}
        </ul>
      </details>
      <button class="icon" type="button" aria-label={t.nav.search} data-search-open>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      </button>
      <a class="icon" href={DISCORD_URL} aria-label="Discord">
        <svg viewBox="0 0 24 24" width="19" height="19" fill="currentColor"><path d="M20.3 4.4A19.6 19.6 0 0 0 15.4 3l-.6 1.3a18.2 18.2 0 0 0-5.6 0L8.6 3a19.5 19.5 0 0 0-4.9 1.5C.6 9.1-.3 13.6.1 18a19.8 19.8 0 0 0 6 3l1.3-2a12.8 12.8 0 0 1-2-1l.5-.4a14 14 0 0 0 12.2 0l.5.4-2 1 1.3 2a19.7 19.7 0 0 0 6-3c.5-5.2-.8-9.6-3.6-13.6ZM8 15.3c-1.2 0-2.2-1.1-2.2-2.4S6.8 10.5 8 10.5s2.2 1.1 2.2 2.4-1 2.4-2.2 2.4Zm8 0c-1.2 0-2.2-1.1-2.2-2.4s1-2.4 2.2-2.4 2.2 1.1 2.2 2.4-1 2.4-2.2 2.4Z"/></svg>
      </a>
      <a class="icon" href={REPO_URL} aria-label="GitHub repository">
        <svg viewBox="0 0 24 24" width="19" height="19" fill="currentColor"><path d="M12 .5a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.2c0 .3.2.7.8.6A11.5 11.5 0 0 0 12 .5Z"/></svg>
      </a>
      <button class="icon theme" type="button" aria-label={t.nav.theme} data-theme-toggle>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <button class="icon menu" type="button" aria-label={t.nav.menu} aria-expanded="false" aria-controls="mobile-nav" data-menu-toggle>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>

  <Search />

  <nav id="mobile-nav" class="mobile" aria-label="Main" hidden>
    {nav.map(({ href, label, current }) => <a href={href} aria-current={current ? "page" : undefined}>{label}</a>)}
  </nav>
</header>

<script>
  document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {}
    document.dispatchEvent(new CustomEvent("themechange", { detail: next }));
  });

  // Close the language menu on a click elsewhere.
  const languages = document.querySelector<HTMLDetailsElement>(".lang");
  document.addEventListener("click", (event) => {
    if (languages?.open && !languages.contains(event.target as Node)) languages.open = false;
  });

  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const mobile = document.getElementById("mobile-nav");
  const setMenu = (open: boolean) => {
    toggle?.setAttribute("aria-expanded", String(open));
    if (mobile) mobile.hidden = !open;
  };
  toggle?.addEventListener("click", () => setMenu(toggle.getAttribute("aria-expanded") !== "true"));
  // Escape closes the menu, and so does widening the window to where the full navigation shows.
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && mobile && !mobile.hidden) {
      setMenu(false);
      toggle?.focus();
    }
  });
  matchMedia("(min-width: 881px)").addEventListener("change", (event) => event.matches && setMenu(false));
</script>

<style>
  /* No view-transition-name: a captured header loses its backdrop blur, so it would flicker as each transition ended.
     As part of the page's crossfade it stays steady, since its pixels are the same on both pages. */
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    text-decoration: none;
    font-family: var(--display);
    font-optical-sizing: auto;
  }
  .nav {
    display: flex;
    gap: 4px;
  }
  .nav a,
  .mobile a {
    padding: 8px 12px;
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.15s, background 0.15s;
  }
  .nav a:hover,
  .nav a[aria-current] {
    color: var(--text);
    background: var(--raised);
  }
  .tools {
    display: flex;
    gap: 2px;
    margin-left: auto;
  }
  .icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--muted);
    cursor: pointer;
  }
  .icon:hover {
    color: var(--text);
    background: var(--raised);
  }
  .menu {
    display: none;
  }
  .lang {
    position: relative;
  }
  .lang summary {
    list-style: none;
  }
  .lang summary::-webkit-details-marker {
    display: none;
  }
  .lang-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    z-index: 60;
    display: grid;
    min-width: 190px;
    margin: 0;
    padding: 6px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--raised);
    box-shadow: 0 20px 40px -16px rgb(0 0 0 / 0.5);
    list-style: none;
  }
  /* On a phone the globe sits near the left edge, so the menu opens rightwards to stay on screen. */
  @media (max-width: 640px) {
    .lang-menu {
      right: auto;
      left: 0;
    }
  }
  .lang-menu a {
    display: block;
    padding: 8px 12px;
    border-radius: 6px;
    color: var(--text);
    font-size: 0.9rem;
    text-decoration: none;
  }
  .lang-menu a:hover {
    background: var(--surface);
  }
  .lang-menu a[aria-current] {
    color: var(--accent);
    font-weight: 600;
  }
  .mobile {
    display: grid;
    gap: 2px;
    padding: 8px var(--gutter) 16px;
    border-top: 1px solid var(--line);
  }
  .mobile a {
    padding: 12px;
    border-radius: var(--radius-sm);
    font-size: 1rem;
  }
  .mobile a[aria-current] {
    color: var(--text);
    background: var(--raised);
  }
  @media (max-width: 880px) {
    .nav {
      display: none;
    }
    .menu {
      display: grid;
    }
  }
</style>
