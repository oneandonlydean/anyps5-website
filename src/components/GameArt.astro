---
import { artSrc, artSrcset } from "../lib/art";
import { hue } from "../lib/view";

interface Props {
  name: string;
  src: string | null;
  color?: string | null;
  ratio: "2/3" | "1/1" | "16/9";
  widths: number[];
  sizes: string;
  /** Loads at once and first: art that is on screen as the page opens. */
  eager?: boolean;
  /** When to load, if not by eager: the home page's moving wall loads every cover at once, since lazy loading can miss
      art that slides into view. */
  loading?: "eager" | "lazy";
  class?: string;
  /** On a list: a view-transition-name applied only while navigating to or from the page this art links to. */
  navTransitionName?: string;
  /** On a detail page: a view-transition-name applied only when the other page has art with that name (see Base.astro). */
  peerTransitionName?: string;
}
const { name, src, color, ratio, widths, sizes, eager = false, loading, class: className, navTransitionName, peerTransitionName } = Astro.props;
const [w, h] = ratio.split("/").map(Number);
const width = widths.at(-1)!;
const tint = color ?? `hsl(${hue(name)} 45% 32%)`;
const ring = `hsl(${(hue(name) + 40) % 360} 70% 60%)`;
// Small tiles (lists, update rows) show up to two initials instead of a name too small to read.
const initials =
  name
    .replace(/[™®©]/g, "")
    .split(/[\s:–—-]+/)
    .filter((w) => /^[\p{L}\p{N}]/u.test(w))
    .slice(0, 2)
    .map((w) => [...w][0]!.toUpperCase())
    .join("") || "?";
---

<div class:list={["art", className]} data-vt={navTransitionName} data-vt-peer={peerTransitionName} style={`--ratio:${ratio};--tint:${tint};--ring:${ring}`}>
  {
    src ? (
      <img
        src={artSrc(src, width)}
        srcset={artSrcset(src, widths)}
        sizes={sizes}
        width={width}
        height={Math.round((width * h) / w)}
        alt=""
        loading={loading ?? (eager ? "eager" : "lazy")}
        fetchpriority={eager ? "high" : undefined}
        decoding="async"
      />
    ) : (
      <span class="fallback" aria-hidden="true">
        <span class="name">{name}</span>
        <span class="initials">{initials}</span>
      </span>
    )
  }
</div>

<script>
  // An image that has arrived (or failed) is marked, which ends its tile's shimmer. Left running, every cover on a page
  // kept a layer of its own animating for as long as the page was open: most of the cost of the home page's wall.
  const settle = (target: EventTarget | null) => target instanceof HTMLImageElement && target.closest(".art") && target.toggleAttribute("data-loaded", true);
  for (const type of ["load", "error"]) document.addEventListener(type, (event) => settle(event.target), true);
  for (const img of document.querySelectorAll<HTMLImageElement>(".art img")) if (img.complete) settle(img);
</script>

<style>
  .art {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    container-type: inline-size;
    background: radial-gradient(120% 90% at 30% 10%, color-mix(in srgb, var(--tint) 70%, white 8%), color-mix(in srgb, var(--tint) 55%, black));
  }
  img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* A tile whose image waits until the screen comes near (loading="lazy") is not drawn before then either, so its
     shimmer is not running out of sight. Its size comes from its ratio, so nothing moves when it is drawn. */
  .art:has(img[loading="lazy"]) {
    content-visibility: auto;
  }
  .art :global(picture) {
    display: contents;
  }
  /* A light sweep while the image loads; it ends when the image arrives (the script above marks it). */
  .art:has(img:not([data-loaded]))::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, transparent 30%, rgb(255 255 255 / 0.14) 50%, transparent 70%);
    translate: -100% 0;
    animation: shimmer 1.6s ease-in-out infinite;
  }
  @keyframes shimmer {
    to {
      translate: 100% 0;
    }
  }
  /* Games without art get their name set large over a textured gradient in a hue picked from the name. */
  .fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: 9cqi;
    background:
      radial-gradient(90% 60% at 100% 0%, color-mix(in srgb, var(--ring) 45%, transparent), transparent 70%),
      repeating-linear-gradient(135deg, rgb(255 255 255 / 0.05) 0 1px, transparent 1px 9px);
  }
  .initials {
    display: none;
  }
  .fallback .name {
    display: -webkit-box;
    overflow: hidden;
    color: rgb(255 255 255 / 0.95);
    font-size: clamp(0.9rem, 13cqi, 2.4rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.04em;
    overflow-wrap: anywhere;
    text-shadow: 0 2px 20px rgb(0 0 0 / 0.35);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
  }
  /* Below about 90 px wide, the name can't be read; centred initials stand in. */
  @container (max-width: 90px) {
    .fallback {
      align-items: center;
      justify-content: center;
      padding: 0;
    }
    .fallback .name {
      display: none;
    }
    .initials {
      display: block;
      color: rgb(255 255 255 / 0.95);
      font-size: 34cqi;
      font-weight: 700;
      letter-spacing: -0.02em;
      text-shadow: 0 1px 8px rgb(0 0 0 / 0.35);
    }
  }
</style>
