---
interface Props {
  values: (number | null)[];
  /** A CSS colour, normally a token. */
  color: string;
  /** Spoken in place of the line, e.g. "Rising from 569 to 6,568 since 15 Sept". */
  label: string;
}

const { values, color, label } = Astro.props;
const known = values.filter((v): v is number => v !== null);
const min = Math.min(...known);
const max = Math.max(...known);
const W = 100;
const H = 28;
const points = values.flatMap((v, i) => (v === null ? [] : [[(i / Math.max(values.length - 1, 1)) * W, H - 2 - ((v - min) / (max - min || 1)) * (H - 4)]]));
const line = points.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(" ");
const id = `spark-${Math.random().toString(36).slice(2, 8)}`;
---

{
  points.length > 1 && (
    <svg class="spark" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" role="img" aria-label={label} style={`--spark:${color}`}>
      <defs>
        <linearGradient id={id} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color={color} stop-opacity="0.28" />
          <stop offset="1" stop-color={color} stop-opacity="0" />
        </linearGradient>
      </defs>
      <polygon points={`${points[0][0]},${H} ${line} ${points.at(-1)![0]},${H}`} fill={`url(#${id})`} />
      <polyline points={line} />
    </svg>
  )
}

<style>
  .spark {
    display: block;
    width: 100%;
    height: 28px;
    overflow: visible;
  }
  polyline {
    fill: none;
    stroke: var(--spark);
    stroke-width: 1.75;
    stroke-linejoin: round;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
</style>
