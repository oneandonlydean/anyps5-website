---
import { stageSlug, type StageOrNone } from "../lib/stages";
import { strings, type Locale } from "../i18n";

interface Props {
  stage: StageOrNone | null;
  onMain?: boolean;
  locale?: Locale;
}
const { stage, onMain = true, locale = "en" } = Astro.props;
const t = strings(locale).stage;
---

<span class="badge" style={`--tone: var(--stage-${stageSlug(stage)})`}>
  <b aria-hidden="true"></b>{t.names[stage ?? "Untested"]}{!onMain && <span class="pr" title={t.prTitle}>PR</span>}
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 4px 10px 4px 8px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--tone) 14%, transparent);
    color: color-mix(in srgb, var(--tone) 70%, var(--text));
    font-size: 0.78rem;
    font-weight: 600;
    white-space: nowrap;
  }
  /* Light stage colours need more of the text colour in them to stay readable at this size. */
  :global(:root[data-theme="light"]) .badge {
    color: color-mix(in srgb, var(--tone) 45%, var(--text));
  }
  b {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--tone);
    box-shadow: 0 0 10px var(--tone);
  }
  .pr {
    padding: 1px 5px;
    border: 1px dashed currentColor;
    border-radius: 4px;
    font: 600 0.62rem/1.3 var(--mono);
    opacity: 0.85;
  }
</style>
