---
import { formatDate } from "../lib/site";
import { QUALIFYING, type TimelineEvent } from "../lib/resolve";
import type { Report } from "../lib/schema";
import { STAGES, stageRank, stageSlug } from "../lib/stages";
import { PLATFORM_LABEL } from "../lib/view";

interface Props {
  reports: Report[];
  timeline: TimelineEvent[];
}

/**
 * A game's history: every report as a dot at its date and stage (hollow when it needed patches), and a stepped line
 * for the furthest stage reached so far.
 */
const { reports, timeline } = Astro.props;
const dated = reports.filter((r) => r.stage).sort((a, b) => a.date.localeCompare(b.date));
const time = (iso: string) => Date.parse(iso);
const first = time(dated[0]?.date ?? timeline[0]?.date);
const last = Math.max(time(dated.at(-1)?.date ?? timeline.at(-1)!.date), ...timeline.map((e) => time(e.date)));
const span = Math.max(last - first, 864e5);
const x = (iso: string) => (last === first ? 50 : 3 + ((time(iso) - first) / span) * 94);
// Rows from the bottom: "No stage" at -1, then each stage.
const ROWS = STAGES.length + 1;
const y = (rank: number) => 100 - ((rank + 1.5) / ROWS) * 100;

const steps = timeline.map((e) => ({ x: x(e.date), y: y(stageRank(e.stage)) }));
const line = steps.length ? [...steps.flatMap((p, i) => (i === 0 ? [p] : [{ x: p.x, y: steps[i - 1].y }, p])), { x: x(new Date(last).toISOString()), y: steps.at(-1)!.y }] : [];
const path = line.map((p, i) => `${i ? "L" : "M"}${p.x.toFixed(2)},${p.y.toFixed(2)}`).join("");
const system = (r: Report) => [r.platform && PLATFORM_LABEL[r.platform], r.gpuVendor].filter(Boolean).join(" · ");
const ticks = last === first ? [first] : [first, first + span / 2, last];
---

<figure class="history">
  <div class="plot">
    <ol class="rows" aria-hidden="true">
      {
        [...STAGES].reverse().map((s) => (
          <li style={`--tone:var(--stage-${stageSlug(s.name)})`}>
            <span>{s.short}</span>
          </li>
        ))
      }
      <li class="none"><span>No stage</span></li>
    </ol>
    <div class="area">
      <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        {path && <path d={path} />}
      </svg>
      {
        dated.map((r) => (
          <a
            class:list={["dot", { patched: !QUALIFYING.has(r.buildKind) }]}
            href={r.url}
            style={`left:${x(r.date)}%;top:${y(stageRank(r.stage))}%;--tone:var(--stage-${stageSlug(r.stage)})`}
            title={`${formatDate(r.date)}: ${r.stage}${system(r) ? ` on ${system(r)}` : ""}${r.author ? `, by ${r.author}` : ""}${QUALIFYING.has(r.buildKind) ? "" : " (with patches)"}`}
          >
            <span class="visually-hidden">
              {formatDate(r.date)}: {r.stage}
            </span>
          </a>
        ))
      }
    </div>
    <div class="dates" aria-hidden="true">
      {ticks.map((t) => <span style={`left:${x(new Date(t).toISOString())}%`}>{formatDate(new Date(t).toISOString())}</span>)}
    </div>
  </div>
  <figcaption>
    <span><i class="key solid"></i> Report on a main build</span>
    <span><i class="key hollow"></i> Needed open pull requests or patches</span>
    <span><i class="key line"></i> Furthest stage so far</span>
  </figcaption>
</figure>

<style>
  .history {
    margin: 0;
  }
  .plot {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: 220px auto;
    column-gap: 12px;
  }
  .rows {
    display: grid;
    grid-template-rows: repeat(9, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rows li {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
    color: var(--faint);
    font-size: 0.72rem;
  }
  .rows li::after {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--tone, var(--stage-none));
  }
  .area {
    position: relative;
    border-left: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: repeating-linear-gradient(to bottom, transparent 0 calc(100% / 9 - 1px), color-mix(in srgb, var(--line) 60%, transparent) calc(100% / 9 - 1px) calc(100% / 9));
  }
  svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    opacity: 0.8;
  }
  .dot {
    position: absolute;
    width: 12px;
    height: 12px;
    border: 2px solid var(--surface);
    border-radius: 50%;
    background: var(--tone);
    box-shadow: 0 0 0 1px var(--tone);
    translate: -50% -50%;
    transition: scale 0.15s var(--ease);
  }
  .dot.patched {
    border: 2px solid var(--tone);
    background: var(--surface);
    box-shadow: none;
  }
  .dot:hover,
  .dot:focus-visible {
    z-index: 1;
    scale: 1.5;
  }
  .dates {
    position: relative;
    grid-column: 2;
    height: 24px;
  }
  .dates span {
    position: absolute;
    top: 6px;
    color: var(--faint);
    font-size: 0.72rem;
    white-space: nowrap;
    translate: -50% 0;
  }
  .dates span:first-child:not(:only-child) {
    translate: 0 0;
  }
  .dates span:last-child:not(:only-child) {
    translate: -100% 0;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-top: 10px;
    color: var(--muted);
    font-size: 0.78rem;
  }
  figcaption span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .key {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .key.solid {
    background: var(--stage-ingame);
  }
  .key.hollow {
    border: 2px solid var(--stage-ingame);
  }
  .key.line {
    width: 16px;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
  }
</style>
