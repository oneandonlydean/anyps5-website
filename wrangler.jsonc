{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // A demo deployment of the site on Cloudflare: npm run deploy:demo. It also runs a test copy of the Discord bot, with
  // its own Discord app, database and webhooks (see "Testing the bot before cutover" in the README). The bot stays off
  // until its TOKEN_KEY secret is set. The production environment below is the official site and bot.
  "name": "anyps5-demo",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // A page is served at the address the site links to (/compatibility), and its other form redirects there. The
    // default is the reverse, which made every link on the site a redirect first.
    "html_handling": "drop-trailing-slash",
    // Everything is a static file except the converter's library downloads, which the Worker streams from upstream,
    // the site's sign-in and API (/auth/*, /api/*), and the Discord bot's endpoints.
    "run_worker_first": ["/convert/app/libraries/*", "/api/*", "/auth/*", "/linked-role", "/discord/callback", "/github/callback", "/interactions"]
  },
  "routes": [{ "pattern": "demo.anyps5.gg", "custom_domain": true }],
  "observability": { "enabled": true },
  "triggers": { "crons": ["* * * * *"] },
  // The site's own data: GitHub sign-in, uploaded run reports, what maintainers hid. Shared with production, so
  // uploads made before cutover carry over.
  "d1_databases": [
    { "binding": "SITE_DB", "database_name": "anyps5-site", "database_id": "0abd405c-2a54-4a94-af66-05b64de4bf78", "migrations_dir": "worker/site-migrations" },
    // The test bot's own database, never the live gh-worker's. Empty to start: the first run only records where
    // things stand, so the backlog is never announced.
    { "binding": "DB", "database_name": "anyps5-bot-test", "database_id": "0b37243f-4f64-42ce-b8a5-bba81a75696b", "migrations_dir": "worker/migrations" }
  ],
  "vars": {
    "MAINTAINERS": "158058829",
    "SITE_REPO": "oneandonlydean/anyps5-website",
    // Ask the site repository to check upstream this often (minutes); it rebuilds only when something changed.
    "SITE_REFRESH_MINUTES": "30",
    "GITHUB_REPO": "boykopovar/AnyPS5",
    "BASE_URL": "https://demo.anyps5.gg",
    // The test Discord app, "AnyPS5 (test)": its Application ID and the public key that verifies slash-command requests.
    // Neither is secret; its client secret and bot token are secrets.
    "DISCORD_CLIENT_ID": "1566680323905953993",
    "DISCORD_PUBLIC_KEY": "d45c3dbab0d9bcfee04786487d8b0d64c99490ff560d28fd85c58dae1c3bb2be",
    // The test bot's GitHub OAuth app, "AnyPS5 bot (test)", for linking GitHub accounts; its client secret is a secret.
    "GITHUB_CLIENT_ID": "Ov23li1p96PYxfbYBiOk"
  },

  "env": {
    // The official site with the Discord bot: npx wrangler deploy --env production. See "Discord bot" in the README
    // for the cutover steps. Until then this environment is not deployed, and the old gh-worker keeps running.
    "production": {
      "name": "anyps5",
      // The official domain. Not deployed until cutover; BASE_URL below matches it.
      "routes": [{ "pattern": "anyps5.gg", "custom_domain": true }],
      "triggers": { "crons": ["* * * * *"] },
      // The gh-worker's existing database, so linked users, merge history and the announcement cursor carry over.
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gh-discord-roles",
          "database_id": "32ee5bdf-8377-4aa2-820f-3233ff722da1",
          "migrations_dir": "worker/migrations"
        },
        { "binding": "SITE_DB", "database_name": "anyps5-site", "database_id": "0abd405c-2a54-4a94-af66-05b64de4bf78", "migrations_dir": "worker/site-migrations" }
      ],
      "vars": {
        "MAINTAINERS": "158058829",
        "SITE_REPO": "oneandonlydean/anyps5-website",
        // Ask the site repository to check upstream this often (minutes); it rebuilds only when something changed.
        "SITE_REFRESH_MINUTES": "30",
        "GITHUB_REPO": "boykopovar/AnyPS5",
        "BASE_URL": "https://anyps5.gg",
        // Public key from the Discord app's General Information page; verifies slash-command requests.
        "DISCORD_PUBLIC_KEY": "800ef93c85606d8c2e8e6e7552b062c30848b7f469d1936d7c67e9cdead806c2"
      }
    }
  }
}
